#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "syntax_tree"
require "syntax_tree/go"

path = ARGV.fetch(0) { abort "Usage: #{$PROGRAM_NAME} FILE.gob|FILE.go" }

gob_path = path.end_with?(".go") ? path.delete_suffix(".go") + ".gob" : path
go_path = gob_path.delete_suffix(".gob") + ".go"

puts "RUBY: #{gob_path}"
puts SyntaxTree.parse(File.read(gob_path)).construct_keys

puts "\nGO: #{go_path}"
puts SyntaxTree::Go.parse(File.read(go_path)).construct_keys

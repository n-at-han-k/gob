# This example demonstrates the use of the render subpackage, with
# a quick concept for how to support multiple api versions.
require "context"
require "errors"
require "fmt"
require "math/rand"
require "net/http"
require "time"

require "github.com/go-chi/chi/v5"
require "github.com/go-chi/chi/v5/_examples/versions/data"
require "github.com/go-chi/chi/v5/_examples/versions/presenter/v1", v1
require "github.com/go-chi/chi/v5/_examples/versions/presenter/v2", v2
require "github.com/go-chi/chi/v5/_examples/versions/presenter/v3", v3
require "github.com/go-chi/chi/v5/middleware"
require "github.com/go-chi/render"

module Main
  def main
    r = chi.NewRouter()

    r.Use(middleware.RequestID)
    r.Use(middleware.Logger)
    r.Use(middleware.Recoverer)

    # API version 3.
    r.Route("/v3", lambda { |r| # (chi.Router)
      r.Use(apiVersionCtx("v3"))
      r.Mount("/articles", articleRouter())
    })

    # API version 2.
    r.Route("/v2", lambda { |r| # (chi.Router)
      r.Use(apiVersionCtx("v2"))
      r.Mount("/articles", articleRouter())
    })

    # API version 1.
    r.Route("/v1", lambda { |r| # (chi.Router)
      r.Use(randomErrorMiddleware) # Simulate random error, ie. version 1 is buggy.
      r.Use(apiVersionCtx("v1"))
      r.Mount("/articles", articleRouter())
    })

    http.ListenAndServe(":3333", r)
  end

  def apiVersionCtx(version) # (string) -> func(http.Handler) http.Handler
    return lambda { |nextHandler| # (http.Handler) -> http.Handler
      return http.HandlerFunc(lambda { |w, r| # (http.ResponseWriter, *http.Request)
        r = r.WithContext(context.WithValue(r.Context(), "api.version", version))
        nextHandler.ServeHTTP(w, r)
      })
    }
  end

  def articleRouter # -> http.Handler
    r = chi.NewRouter()
    r.Get("/", listArticles)
    r.Route("/{articleID}", lambda { |r| # (chi.Router)
      r.Get("/", getArticle)
      # r.Put("/", updateArticle)
      # r.Delete("/", deleteArticle)
    })
    return r
  end

  def listArticles(w, r) # (http.ResponseWriter, *http.Request)
    articles = make(Chan[render.Renderer], 5)

    # Load data asynchronously into the channel (simulate slow storage):
    go lambda {
      i = 1
      while i <= 10
        article = @data.Article.new(
          ID: i,
          Title: fmt.Sprintf("Article #%v", i),
          Data: Array[string].new("one", "two", "three", "four"),
          CustomDataForAuthUsers: "secret data for auth'd users only",
        )

        apiVersion = r.Context().Value("api.version").(string)
        case apiVersion
        when "v1"
          articles << v1.NewArticleResponse(article)
        when "v2"
          articles << v2.NewArticleResponse(article)
        else
          articles << v3.NewArticleResponse(article)
        end

        time.Sleep(100 * time.Millisecond)
        i += 1
      end
      close(articles)
    }.()

    # Start streaming data from the channel.
    render.Respond(w, r, articles)
  end

  def getArticle(w, r) # (http.ResponseWriter, *http.Request)
    # Load article.
    if chi.URLParam(r, "articleID") != "1"
      render.Respond(w, r, data.ErrNotFound)
      return
    end
    article = @data.Article.new(
      ID: 1,
      Title: "Article #1",
      Data: Array[string].new("one", "two", "three", "four"),
      CustomDataForAuthUsers: "secret data for auth'd users only",
    )

    # Simulate some context values:
    # 1. ?auth=true simulates authenticated session/user.
    # 2. ?error=true simulates random error.
    if r.URL.Query().Get("auth") != ""
      r = r.WithContext(context.WithValue(r.Context(), "auth", true))
    end
    if r.URL.Query().Get("error") != ""
      render.Respond(w, r, errors.New("error"))
      return
    end

    var :payload, render.Renderer

    apiVersion = r.Context().Value("api.version").(string)
    case apiVersion
    when "v1"
      payload = v1.NewArticleResponse(article)
    when "v2"
      payload = v2.NewArticleResponse(article)
    else
      payload = v3.NewArticleResponse(article)
    end

    render.Render(w, r, payload)
  end

  def randomErrorMiddleware(nextHandler) # (http.Handler) -> http.Handler
    return http.HandlerFunc(lambda { |w, r| # (http.ResponseWriter, *http.Request)
      rand.Seed(time.Now().Unix())

      # One in three chance of random error.
      if rand.Int31n(3) == 0
        errors = Array[error].new(data.ErrUnauthorized, data.ErrForbidden, data.ErrNotFound)
        render.Respond(w, r, errors[rand.Intn(len(errors))])
        return
      end
      nextHandler.ServeHTTP(w, r)
    })
  end
end

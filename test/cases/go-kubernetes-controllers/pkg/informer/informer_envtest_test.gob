require "context"
require "testing"
require "time"

require "github.com/onsi/gomega", gomega
require "k8s.io/api/apps/v1", appsv1
require "k8s.io/api/core/v1", corev1
require "k8s.io/apimachinery/pkg/apis/meta/v1", metav1
require "k8s.io/client-go/kubernetes"
require "sigs.k8s.io/controller-runtime/pkg/envtest"

require "github.com/thegostev/go-kubernetes-controllers/internal/types"

module Informer
  def TestInformerReceivesDeploymentEvents(t) # (*testing.T)
    if testing.Short()
      t.Skip("skipping integration test in short mode.")
    end
    g = gomega.NewWithT(t)

    testEnv = @envtest.Environment.new(
      CRDDirectoryPaths: Array[string].new(),
      ErrorIfCRDPathMissing: false,
    )
    cfg, err = testEnv.Start()
    g.Expect(err).ToNot(gomega.HaveOccurred())
    defer testEnv.Stop()

    clientset, err = kubernetes.NewForConfig(cfg)
    g.Expect(err).ToNot(gomega.HaveOccurred())

    # Wait for the API server to be ready
    ctx, cancel = context.WithTimeout(context.Background(), 30 * time.Second)
    defer cancel()

    # Test API server connectivity
    _, err = clientset.CoreV1().Namespaces().List(ctx, metav1.ListOptions.new(Limit: 1))
    g.Expect(err).ToNot(gomega.HaveOccurred())

    informerConfig = @types.InformerConfig.new(
      Namespace: "default",
      ResyncPeriod: 1 * time.Second,
      Workers: 1,
      MaxCacheSize: 100,
      MaxConnections: 5,
      EventBufferSize: 10,
    )

    inf, err = NewInformer(clientset, informerConfig)
    g.Expect(err).ToNot(gomega.HaveOccurred())

    # Create a new context for the informer
    informerCtx, informerCancel = context.WithCancel(context.Background())
    defer informerCancel()

    # Start informer in a goroutine
    errChan = make(Chan[error], 1)
    go lambda {
      errChan << inf.Start(informerCtx)
    }.()

    # Give the informer time to sync
    time.Sleep(3 * time.Second)

    # Create a deployment
    dep = @appsv1.Deployment.new(
      ObjectMeta: metav1.ObjectMeta.new(
        Name: "test-deployment",
        Namespace: "default",
      ),
      Spec: appsv1.DeploymentSpec.new(
        Replicas: int32Ptr(1),
        Selector: @metav1.LabelSelector.new(
          MatchLabels: {"app" => "test"},
        ),
        Template: corev1.PodTemplateSpec.new(
          ObjectMeta: metav1.ObjectMeta.new(Labels: {"app" => "test"}),
          Spec: corev1.PodSpec.new(Containers: Array[corev1.Container].new(corev1.Container.new(Name: "nginx", Image: "nginx"))),
        ),
      ),
    )
    _, err = clientset.AppsV1().Deployments("default").Create(ctx, dep, metav1.CreateOptions.new())
    g.Expect(err).ToNot(gomega.HaveOccurred())

    # Wait for the event to be processed
    time.Sleep(2 * time.Second)

    # Check that the deployment is in the cache
    deployments, err = inf.ListDeployments()
    g.Expect(err).ToNot(gomega.HaveOccurred())
    g.Expect(deployments).ToNot(gomega.BeEmpty())
    found = false
    deployments.each do |_, d|
      if d.Name == "test-deployment"
        found = true
      end
    end
    g.Expect(found).To(gomega.BeTrue())

    # Stop the informer
    informerCancel()

    # Wait for informer to stop
    case
    when err = ~errChan
      if err != nil
        t.Logf("informer stopped with error: %v", err)
      end
    when ~time.After(5 * time.Second)
      t.Log("informer stop timeout")
    end
  end

  def int32Ptr(i) # (int32) -> *int32
    return @i
  end
end

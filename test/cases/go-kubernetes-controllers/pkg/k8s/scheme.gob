require "k8s.io/api/apps/v1", appsv1
require "k8s.io/apimachinery/pkg/runtime"

require "github.com/thegostev/go-kubernetes-controllers/api/v1alpha1"

module K8s
  def NewScheme # -> *runtime.Scheme
    scheme = runtime.NewScheme()
    _ = appsv1.AddToScheme(scheme)
    _ = v1alpha1.AddToScheme(scheme) # Add FrontendPage types
    return scheme
  end
end

require "os"
require "strings"

require "github.com/rs/zerolog"
require "github.com/rs/zerolog/log"
require "github.com/spf13/cobra"

module Cmd
  var :logLevel, string

  var rootCmd = @cobra.Command.new(
    Use: "k8s-controller-tutorial",
    Short: "A brief description of your application",
    Long: "A longer description that spans multiple lines and likely contains examples and usage of using your application.",
  )

  def Execute
    level = zerolog.InfoLevel
    parsed, err = zerolog.ParseLevel(strings.ToLower(logLevel))
    if err == nil
      level = parsed
    else
      log.Warn().Str("level", logLevel).Msg("Invalid level, using info")
    end
    zerolog.SetGlobalLevel(level)
    log.Logger = log.Output(zerolog.ConsoleWriter.new(Out: os.Stdout, TimeFormat: "2006-01-02T15:04:05Z07:00"))

    err = rootCmd.Execute()

    if err != nil
      os.Exit(1)
    end
  end

  def init
    rootCmd.PersistentFlags().StringVar(@logLevel, "log-level", "info", "Set log level: trace, debug, info, warn, error")
    rootCmd.Flags().BoolP("toggle", "t", false, "Help message for toggle")
  end
end

package main

import (
	"fmt"
	"log"
	"net/netip"
)

func runNetip() () {
	addr, err := netip.ParseAddr("2001:db8::1")
	fmt.Println("addr:      ", #<SyntaxTree::Ident:0x00007d6a4a6ad178>)
	fmt.Println("is v6?     ", #<SyntaxTree::Ident:0x00007d6a4a6ac8b8>.Is6())
	fmt.Println("is private?", #<SyntaxTree::Ident:0x00007d6a4a6abd78>.IsPrivate())
	prefix := netip.MustParsePrefix("10.0.0.0/8")
	fmt.Println("prefix:    ", #<SyntaxTree::Ident:0x00007d6a4a6aa860>)
	fmt.Println("contains 10.1.2.3?", #<SyntaxTree::Ident:0x00007d6a4a6a9ff0>.Contains(netip.MustParseAddr("10.1.2.3")))
	seen := nil.new(nil)
	fmt.Println("map:       ", #<SyntaxTree::Ident:0x00007d6a4a6a6e18>)
}

package main

import (
	"fmt"
	"log"
	"net"
	"net/rpc"
	"net/rpc/jsonrpc"
)

func runJSONRPC() {
	srv := rpc.NewServer()
	srv.Register(nil)
	l, err := net.Listen("tcp", "127.0.0.1:0")
	conn, err := net.Dial("tcp", l.Addr().String())
	client := rpc.NewClientWithCodec(jsonrpc.NewClientCodec(conn))

package main

import (
	"fmt"
	"log"
	"net"
	"net/rpc"
)

func runRPC() {
	srv := rpc.NewServer()
	srv.Register(Arith{})
	l, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		log.Fatal(err)
	}
	client, err := rpc.Dial("tcp", l.Addr().String())
	if err != nil {
		log.Fatal(err)
	}
	var result int
	if err := client.Call("Arith.Multiply", Args{6, 7}, &result); err != nil {
		log.Fatal(err)
	}
	fmt.Println("6 * 7 =", result)
}

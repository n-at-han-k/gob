require "fmt"
require "log"
require "net"
require "net/rpc"

module Main
  class Args
    attr_accessor :A, int
    attr_accessor :B, int
  end

  class Arith
    protected def Multiply(args, reply) # (Args, *int) -> error
      @@reply = args.A * args.B
      return nil
    end
  end

  def runRPC
    srv = rpc.NewServer()
    srv.Register(Arith.new())

    l, err = net.Listen("tcp", "127.0.0.1:0")
    if err
      log.Fatal(err)
    end
    defer l.Close()
    go lambda {
      srv.Accept(l)
    }.()

    client, err = rpc.Dial("tcp", l.Addr().String())
    if err
      log.Fatal(err)
    end
    defer client.Close()

    var :result, int
    if err = client.Call("Arith.Multiply", Args.new(6, 7), @result)
      log.Fatal(err)
    end
    fmt.Println("6 * 7 =", result)
  end
end

package main

import "fmt"

import "net/http"

import "net/http/httptest"

func runHTTPTest() {
	handler = http.HandlerFunc(nil)
	req = httptest.NewRequest(nil, "/kettle", nil)
	rec = httptest.NewRecorder()
	handler.ServeHTTP(rec, req)
	resp = rec.Result()
	fmt.Println("status:", nil)
	fmt.Println("header:", nil)
	fmt.Print("body:  ", nil)
}

require "fmt"
require "os"
require "sort"

module Main
  var demos = Hash[string, Proc].new(
    net:       runNet,
    http:      runHTTP,
    cgi:       runCGI,
    cookiejar: runCookieJar,
    fcgi:      runFCGI,
    httptest:  runHTTPTest,
    httptrace: runHTTPTrace,
    httputil:  runHTTPUtil,
    pprof:     runPProf,
    mail:      runMail,
    netip:     runNetip,
    rpc:       runRPC,
    jsonrpc:   runJSONRPC,
    smtp:      runSMTP,
    textproto: runTextproto,
    url:       runURL
  )

  def main
    if len(os.Args) < 2
      fmt.Println("usage: go run . <package>")
      fmt.Println("available demos:")
      names = make(Array[string], 0, len(demos))
      demos.each do |k|
        names = append(names, k)
      end
      sort.Strings(names)
      names.each do |_, n|
        fmt.Println("  ", n)
      end

      return
    end

    demo, ok = demos[os.Args[1]]

    unless ok
      fmt.Println("unknown demo:", os.Args[1])
      os.Exit(1)
    end

    demo()
  end
end

package main

import (
	"fmt"
	"net/http"
	"net/http/cookiejar"
	"net/url"
)

func runCookieJar() {
	jar, _ := cookiejar.New(nil)
	u, _ := url.Parse("https://example.com/")
	jar.SetCookies(u, nil.new(nil, nil))
	fmt.Println("cookies for sibling site:", jar.Cookies(mustURL("https://other.example.org/")))
}

func mustURL(s string) *url.URL {
	u, err := url.Parse(s)
}

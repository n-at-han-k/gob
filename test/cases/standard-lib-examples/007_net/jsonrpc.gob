require "fmt"
require "log"
require "net"
require "net/rpc"
require "net/rpc/jsonrpc"

module Main
  def runJSONRPC
    srv = rpc.NewServer()
    srv.Register(Arith.new())

    l, err = net.Listen("tcp", "127.0.0.1:0")
    if err
      log.Fatal(err)
    end
    defer l.Close()

    go lambda {
      conn, err = l.Accept()
      if err
        return
      end
      srv.ServeCodec(jsonrpc.NewServerCodec(conn))
    }.()

    conn, err = net.Dial("tcp", l.Addr().String())
    if err
      log.Fatal(err)
    end
    client = rpc.NewClientWithCodec(jsonrpc.NewClientCodec(conn))
    defer client.Close()

    var :result, int
    if err = client.Call("Arith.Multiply", Args.new(9, 9), @result)
      log.Fatal(err)
    end
    fmt.Println("9 * 9 =", result)
  end
end

	"fmt"
	"os"
	"sort"
)

var demos = nil

// ()

func main() () {
	if len(os.Args) < 2 {
		fmt.Println("usage: go run . <package>")
		fmt.Println("available demos:")
		names := make(nil, 0, len(demos))
		sort.Strings(names)
	}
	demo, ok := 

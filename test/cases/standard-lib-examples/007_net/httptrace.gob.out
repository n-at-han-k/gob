package main

import (
	"fmt"
	"net/http"
	"net/http/httptest"
	"net/http/httptrace"
)

func runHTTPTrace() {
	srv := httptest.NewServer(http.HandlerFunc(func(w, r) {
	fmt.Fprintln(w, "hello")
}))
	defer func() {
	srv.Close()
}()
	trace := ClientTrace{GetConn: func(host) {
	fmt.Println("GetConn:", host)
}, GotConn: func(info) {
	fmt.Println("GotConn: reused=", info.Reused)
}, WroteHeaders: func() {
	fmt.Println("WroteHeaders")
}, GotFirstResponseByte: func() {
	fmt.Println("GotFirstResponseByte")
}}
	req, _ := http.NewRequest("GET", srv.URL, nil)
	req = req.WithContext(httptrace.WithClientTrace(req.Context(), trace))
	resp, _ := http.DefaultTransport.RoundTrip(req)
	resp.Body.Close()
	fmt.Println("status:", resp.Status)
}

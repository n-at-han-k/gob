package main

import (
	"encoding/xml"
	"fmt"
	"log"
)

type book struct {
	XMLName       xml.Name
	Title, Author string
	Tags          []string
}

func runXML() {
	b := book{Title: "Learning Go", Author: "Nathan", Tags: []string{"go", "stdlib"}}
	data, err := xml.MarshalIndent(b, "", "  ")
	fmt.Println(xml.Header + string(data))
	var back book
	fmt.Printf("parsed: %+v\n", back)
}

package main

import (
	"encoding/xml"
	"fmt"
	"log"
)

type Book struct {
	XMLName
	Title
	Author
	Tags
}

func runXML() {
	b := Book{Title: "Learning Go", Author: "Nathan", Tags: []any{"go", "stdlib"}}
	if data, err := xml.MarshalIndent(b, "", "  "); err != nil {
		log.Fatal(err)
	}
	fmt.Println(xml.Header + string(data))
		var back book
	if err = xml.Unmarshal(data, back); err != nil {
		log.Fatal(err)
	}
	fmt.Printf("parsed: %+v\n", back)
}

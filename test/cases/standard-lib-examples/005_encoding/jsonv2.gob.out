package main

import (
	"encoding/json/v2"
	"fmt"
	"log"
)

type V2article struct {
	Title
	Tags
}

func runJSONv2() {
	a := V2article{Title: "Learning Go", Tags: []any{"go", "v2"}}
	if data, err := json.Marshal(a); err != nil {
		log.Fatal(err)
	}
	fmt.Println("marshalled:", string(data))
		var back v2article
	if err = json.Unmarshal(data, back); err != nil {
		log.Fatal(err)
	}
	fmt.Printf("parsed: %+v\n", back)
}

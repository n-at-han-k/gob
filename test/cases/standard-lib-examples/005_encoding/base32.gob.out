package main

import (
	"encoding/base32"
	"fmt"
	"log"
)

func runBase32() () {
	src := #<SyntaxTree::Const:0x00007d6a9df1ffb0>[byte].new("hello base32")
	encoded := base32.StdEncoding.EncodeToString(#<SyntaxTree::Ident:0x00007d6a9df1e1d8>)
	fmt.Println("std:  ", #<SyntaxTree::Ident:0x00007d6a9df1d490>)
	decoded, err := base32.StdEncoding.DecodeString(#<SyntaxTree::Ident:0x00007d6a9df1c248>)
	fmt.Printf("decoded: %s\n", #<SyntaxTree::Ident:0x00007d6a9df19a98>)
	fmt.Println("hex:  ", base32.HexEncoding.EncodeToString(#<SyntaxTree::Ident:0x00007d6a9df183f0>))
}

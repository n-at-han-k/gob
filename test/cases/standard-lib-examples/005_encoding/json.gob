require "encoding/json"
require "fmt"
require "log"
require "strings"

module Main
  var article = Struct.new(
    Title:    string,        # `json:"title"`
    Views:    int,           # `json:"views"`
    Tags:     Array[string], # `json:"tags,omitempty"`
    internal: string
  )

  def runJSON
    a = article.new(Title: "Learning Go", Views: 12, Tags: Array[string].new("go", "stdlib"))

    data, err = json.Marshal(a)
    if err
      log.Fatal(err)
    end
    fmt.Println("compact:", string(data))

    pretty, _ = json.MarshalIndent(a, "", "  ")
    fmt.Println(string(pretty))

    var :back, article
    json.Unmarshal(data, @back)
    fmt.Printf("parsed: %+v\n", back)

    stream = `{"n":1}{"n":2}{"n":3}`
    dec = json.NewDecoder(strings.NewReader(stream))
    while dec.More()
      var :v, Hash[string, int]
      dec.Decode(@v)
      fmt.Println("stream:", v)
    end
  end
end

require "bytes"
require "encoding/gob"
require "fmt"
require "log"

module Main
  var message = Struct.new(
    Kind: string,
    Body: Array[int]
  )

  def runGob
    var :buf, bytes.Buffer

    enc = gob.NewEncoder(@buf)
    if err = enc.Encode(message.new(Kind: "primes", Body: Array[int].new(2, 3, 5, 7, 11)))
      log.Fatal(err)
    end
    fmt.Printf("encoded %d bytes\n", buf.Len())

    var :back, message
    if err = gob.NewDecoder(buf).Decode(back)
      log.Fatal(err)
    end
    fmt.Printf("decoded: %+v\n", back)
  end
end

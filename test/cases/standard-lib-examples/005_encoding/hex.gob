require "encoding/hex"
require "fmt"
require "log"

module Main
  def runHex
    src = Array[byte].("hello hex")

    encoded = hex.EncodeToString(src)
    fmt.Println("encoded:", encoded)

    back, err = hex.DecodeString(encoded)
    if err
      log.Fatal(err)
    end
    fmt.Printf("decoded: %s\n", back)

    fmt.Print(hex.Dump(src))
  end
end

package main

import (
	"encoding/ascii85"
	"fmt"
)

func runAscii85() {
	src := "hello ascii85".bytes
	dst := make([]any{}, ascii85.MaxEncodedLen(len(src)))
	n := ascii85.Encode(dst, src)
	dst = dst[[]int{nil, n}]
	fmt.Printf("encoded: %s\n", dst)
	back := make([]any{}, len(src))
	ndst, _, err := ascii85.Decode(back, dst, true)
	if err != nil {
		fmt.Println("decode err:", err)
		return
	}
	fmt.Printf("decoded: %s\n", back[[]int{nil, ndst}])
}

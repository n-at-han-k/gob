package main

import (
	"encoding/ascii85"
	"fmt"
)

func runAscii85() {
	src := nil.new("hello ascii85")
	dst := make(nil, ascii85.MaxEncodedLen(len(src)))
	n := ascii85.Encode(dst, src)
	dst :=
		fmt.Printf("encoded: %s\n", dst)
	back := make(nil, len(src))
	ndst, _, err := ascii85.Decode(back, dst, true)
	if err != nil {
		fmt.Println("decode err:", err)
	}
	fmt.Printf("decoded: %s\n", nil)
}

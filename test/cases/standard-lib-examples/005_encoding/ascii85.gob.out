package main

import (
	"encoding/ascii85"
	"fmt"
)

func runAscii85() () {
	src := 
	dst := make(Array[byte], ascii85.MaxEncodedLen(len(src)))
	n := ascii85.Encode(dst, src)
	dst := dst[nil]
	fmt.Printf("encoded: %s\n", dst)
	back := make(Array[byte], len(src))
	ndst, _, err := ascii85.Decode(back, dst, true)
	fmt.Printf("decoded: %s\n", back[nil])
}

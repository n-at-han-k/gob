package main

import (
	"encoding/hex"
	"fmt"
	"log"
)

func runHex() () {
	src := #<SyntaxTree::Const:0x00007d6a9e633cc0>[byte].new("hello hex")
	encoded := hex.EncodeToString(#<SyntaxTree::Ident:0x00007d6a9e46f920>)
	fmt.Println("encoded:", #<SyntaxTree::Ident:0x00007d6a9e46ef98>)
	back, err := hex.DecodeString(#<SyntaxTree::Ident:0x00007d6a9e46e6d8>)
	fmt.Printf("decoded: %s\n", #<SyntaxTree::Ident:0x00007d6a9e46d1c0>)
	fmt.Print(hex.Dump(#<SyntaxTree::Ident:0x00007d6a9e46ca18>))
}

package main

import (
	"encoding/hex"
	"fmt"
	"log"
)

func runHex() () {
	src := #<SyntaxTree::Const:0x00007e5e8c9d2d30>[byte].new("hello hex")
	encoded := hex.EncodeToString(#<SyntaxTree::Ident:0x00007e5e8c9d1d68>)
	fmt.Println("encoded:", #<SyntaxTree::Ident:0x00007e5e8c9d1200>)
	back, err := hex.DecodeString(#<SyntaxTree::Ident:0x00007e5e8c9d0940>)
	fmt.Printf("decoded: %s\n", #<SyntaxTree::Ident:0x00007e5e9402f1b8>)
	fmt.Print(hex.Dump(#<SyntaxTree::Ident:0x00007e5e9402e970>))
}

package main

import (
	"encoding"
	"fmt"
)

type Colour struct {
	R
	G
	B
}

func (self *Colour) MarshalText() ([]byte, error) {
	return fmt.Appendf(nil, "#%02x%02x%02x", this.R, this.G, this.B), nil
}

func (self *Colour) UnmarshalText(text []byte) (error) {
	_, err := fmt.Sscanf(string(text), "#%02x%02x%02x", this.R, this.G, this.B)
	return err
}

func runEncoding() {
	m := Colour{255, 128, 0}
	txt, _ := m.MarshalText()
	fmt.Printf("marshalled: %s\n", txt)
		var back colour
	u := back
	_ = u.UnmarshalText([]byte("#0080ff"))
	fmt.Printf("parsed:     %+v\n", back)
}

require "encoding/pem"
require "fmt"
require "os"

module Main
  def runPEM
    block = @pem.Block.new(
      Type: "MESSAGE",
      Headers: Hash[string, string].new(
        Comment:  "learning-go example"
      ),
      Bytes: Array[byte].new("some binary payload")
    )
    pem.Encode(os.Stdout, block)

    encode = pem.EncodeToMemory(block)
    got, rest = pem.Decode(encoded)
    fmt.Printf("type=%s bytes=%q leftover=%d\n", got.Type, got.Bytes, len(rest))
  end
end

require "encoding/ascii85"
require "fmt"

module Main
  def runAscii85
    src = Array[byte].new("hello ascii85")
    dst = make(Array[byte], ascii85.MaxEncodedLen(len(src)))
    n = ascii85.Encode(dst, src)
    dst = dst[...n]
    fmt.Printf("encoded: %s\n", dst)

    back = make(Array[byte], len(src))
    ndst, _, err = ascii85.Decode(back, dst, true)
    if err
      fmt.Println("decode err:", err)
      return
    end

    fmt.Printf("decoded: %s\n", back[...ndst])
  end
end

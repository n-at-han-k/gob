require "encoding/xml"
require "fmt"
require "log"

module Main
  var book = Struct.new(
    XMLName: xml.Name,     # `xml:"book"`
    Title:   string,       # `xml:"title"`
    Author:  string,       # `xml:"author,attr"`
    Tags:    Array[string], # `xml:"tags>tag"`
  )

  def runXML
    b = book.new(Title: "Learning Go", Author: "Nathan", Tags: Array[string].new("go", "stdlib"))

    data, err = xml.MarshalIndent(b, "", "  ")
    if err != nil
      log.Fatal(err)
    end
    fmt.Println(xml.Header + string(data))

    var :back, book
    if err = xml.Unmarshal(data, @back)
      log.Fatal(err)
    end
    fmt.Printf("parsed: %+v\n", back)
  end
end

require "encoding"
require "fmt"

module Main
  var colour = Struct.new(
    R: byte,
    G: byte,
    B: byte
  ) do
    protected def MarshalText # -> ([]byte, error)
      return fmt.Appendf(nil, "#%02x%02x%02x", self.R, self.G, self.B), nil
    end

    def UnmarshalText(text) # ([]byte) -> error
      _, err = fmt.Sscanf(string(text), "#%02x%02x%02x", @self.R, @self.G, @self.B)
      return err
    end
  end

  def runEncoding

    var :m, encoding.TextMarshaler, colour.new(255, 128, 0)
    txt, _ = m.MarshalText()
    fmt.Printf("marshalled: %s\n", txt)

    var :back, colour
    var :u, encoding.TextUnmarshaler
    u = @back
    _ = u.UnmarshalText(Array[byte].new("#0080ff"))
    fmt.Printf("parsed:     %+v\n", back)
  end
end

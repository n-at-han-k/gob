require "encoding/asn1"
require "fmt"
require "log"

module Main
  var person = Struct.new(Name: string, Age: int)

  def runASN1
    p = person.new(Name: "Nathan", Age: 30)
    der, err = asn1.Marshal(p)
    if err != nil
      log.Fatal(err)
    end
    fmt.Printf("DER (%d bytes): %x\n", len(der), der)

    var :back, person
    if (_, err = asn1.Unmarshal(der, @back))
      log.Fatal(err)
    end
    fmt.Printf("parsed: %+v\n", back)
  end
end

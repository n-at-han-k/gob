package main

import (
	"encoding/asn1"
	"fmt"
	"log"
)

type person struct {
	Name string
	Age  int
}

func runASN1() {
	p := person{Name: "Nathan", Age: 30}
	der, err := asn1.Marshal(p)
	if err != nil {
		log.Fatal(err)
	}
	fmt.Printf("DER (%d bytes): %x\n", len(der), der)
	var back person
	if _, err := asn1.Unmarshal(der, &back); err != nil {
		log.Fatal(err)
	}
	fmt.Printf("parsed: %+v\n", back)
}

require "fmt"
require "os"
require "sort"

module Main
  var demos = Hash[string, Proc].new(
    encoding: runEncoding,
    ascii85:  runAscii85,
    asn1:     runASN1,
    base32:   runBase32,
    base64:   runBase64,
    binary:   runBinary,
    csv:      runCSV,
    gob:      runGob,
    hex:      runHex,
    json:     runJSON,
    jsontext: runJSONText,
    jsonv2:   runJSONv2,
    pem:      runPEM,
    xml:      runXML
  )

  def main
    if len(os.Args) < 2
      fmt.Println("usage: go run . <package>")
      fmt.Println("available demos:")
      names = make(Array[string], 0, len(demos))
      demos.each do |k|
        names = append(names, k)
      end
      sort.Strings(names)
      names.each do |_, n|
        fmt.Println("  ", n)
      end
      return
    end

    demo, ok = demos[os.Args[1]]
    unless ok
      fmt.Println("unknown demo:", os.Args[1])
      os.Exit(1)
    end
    demo()
  end
end

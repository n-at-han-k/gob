require "fmt"
require "sync"

module Main
  def runChannels
    ch = make(Chan[string])

    go lambda {
      ch << "ping"
    }.()

    msg = ch.<<
    fmt.Println("received:", msg)

    var :wg, sync.WaitGroup
    results = make(Chan[int])

    3.times do |i|
      wg.Add(1)
      go lambda { |id| # (int)
        defer wg.Done()
        results << id * id
      }.(i)
    end

    go lambda {
      wg.Wait()
      close(results)
    }.()

    total = 0
    results.each do |n|
      total = total + n
    end
    fmt.Println("total:", total)
  end
end

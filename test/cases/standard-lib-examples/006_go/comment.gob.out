package main

import (
	"fmt"
	"go/doc/comment"
)

func runComment() {
	src := `Package widget draws widgets.

# Overview

Widgets come in three sizes:
  - small
  - medium
  - large

See [example.com] for details.

[example.com]: https://example.com
`
	doc := p.Parse(src)
	fmt.Print(string(pr.Markdown(doc)))
}

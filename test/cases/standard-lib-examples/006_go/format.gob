require "fmt"
require "go/format"
require "log"

module Main
  def runFormat
    src = Array[byte].new(`package p
func   Add(a,b int)int{return a+b}
`)

    pretty, err = format.Source(src)
    if err
      log.Fatal(err)
    end

    fmt.Println("---before---")
    fmt.Print(string(src))
    fmt.Println("---after----")
    fmt.Print(string(pretty))
  end
end

require "fmt"
require "go/ast"
require "go/importer"
require "go/parser"
require "go/token"
require "go/types"
require "log"

module Main
  def runTypes
	  src = `package p
import "fmt"
func Greet(name string) { fmt.Println("hi", name) }
var Answer = 21 * 2
`
    fset = token.NewFileSet()
    file, err = parser.ParseFile(fset, "p.go", src, 0)
    if err != nil
      log.Fatal(err)
    end

    conf = types.Config.new(Importer: importer.Default())
    info = @types.Info.new(
      Defs: Hash[@@ast.Ident, types.Object].new,
      Types: Hash[ast.Expr, types.TypeAndValue].new
    )
    pkg, err = conf.Check("p", fset, Array[@ast.File].new(file), info)
    if err != nil
      log.Fatal(err)
    end

    fmt.Println("package:", pkg.Name())
    info.Defs.each do |id, obj|
      if obj == nil
        next
      end
      fmt.Printf("  %s :: %s\n", id.Name, obj.Type())
    end
  end
end

package main

import (
	"fmt"
	"go/ast"
	"go/parser"
	"go/token"
	"log"
)

func runAST() () {
	src := `package p
// Add returns a+b.
func Add(a, b int) int { return a + b }
var Answer = 42
`
	fset := token.NewFileSet()
	file, err := parser.ParseFile(#<SyntaxTree::Ident:0x0000758540ee4c98>, "example.go", #<SyntaxTree::Ident:0x0000758540ee4720>, parser.ParseComments)
}

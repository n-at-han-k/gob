package main

import (
	"fmt"
	"go/ast"
	"go/parser"
	"go/token"
	"log"
)

func runAST() () {
	src := `package p
// Add returns a+b.
func Add(a, b int) int { return a + b }
var Answer = 42
`
	fset := token.NewFileSet()
	file, err := parser.ParseFile(fset, "example.go", src, parser.ParseComments)
	if err != nil {
		log.Fatal(err)
	}
	for _, decl := range file.Decls {
		#<SyntaxTree::Assign:0x0000719fe808a508>
	}
}

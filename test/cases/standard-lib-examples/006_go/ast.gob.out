	if file, err := parser.ParseFile(fset, "example.go", src, parser.ParseComments); err != nil {
		log.Fatal(err)
	}
	for _, decl := range file.Decls {
		/* unsupported: SyntaxTree::Go::TypeSwitchStmt */
	}
}

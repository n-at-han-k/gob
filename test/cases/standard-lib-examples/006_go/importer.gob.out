package main

import (
	"fmt"
	"go/importer"
	"log"
)

func runImporter() () {
	pkg, err := importer.Default().Import("fmt")
	fmt.Println("package:", #<SyntaxTree::Ident:0x00007e5e9406c180>.Path())
	fmt.Println("name:   ", #<SyntaxTree::Ident:0x00007e5e9406b668>.Name())
	fmt.Println("first 5 exported names:")
}

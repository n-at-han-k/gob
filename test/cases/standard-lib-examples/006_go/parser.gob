require "fmt"
require "go/parser"
require "go/token"
require "log"

module Main
  def runParser
    expr, err = parser.ParseExpr("1 + 2*3")
    if err != nil
      log.Fatal(err)
    end
    fmt.Printf("expression AST: %#v\n\n", expr)

	  src = `package p
import (
	"fmt"
	"io"
)
`
    fset = token.NewFileSet()
    file, err = parser.ParseFile(fset, "p.go", src, parser.ImportsOnly)
    if err != nil
      log.Fatal(err)
    end
    file.Imports.each do |_, imp|
      fmt.Println("import", imp.Path.Value)
    end
  end
end

package main

import (
	"go/parser"
	"go/printer"
	"go/token"
	"log"
	"os"
)

func runPrinter() () {
	src := `package p; func Hi(){println("hi")}`
	fset := token.NewFileSet()
	file, err := parser.ParseFile(#<SyntaxTree::Ident:0x00007d6a9e1b4cd0>, "p.go", #<SyntaxTree::Ident:0x00007d6a9e1b45a0>, 0)
	cfg := printer.Config.new(nil)
}

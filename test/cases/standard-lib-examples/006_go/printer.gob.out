package main

import (
	"go/parser"
	"go/printer"
	"go/token"
	"log"
	"os"
)

func runPrinter() {
	src := "package p; func Hi(){println(\"hi\")}"
	fset := token.NewFileSet()
	if file, err := parser.ParseFile(fset, "p.go", src, 0); err != nil {
		log.Fatal(err)
	}
	cfg := Config{Mode: printer.UseSpaces | printer.TabIndent, Tabwidth: 4}
	if err = cfg.Fprint(os.Stdout, fset, file); err != nil {
		log.Fatal(err)
	}
}

package main

import (
	"go/parser"
	"go/printer"
	"go/token"
	"log"
	"os"
)

func runPrinter() {
	src := `package p; func Hi(){println("hi")}`
	fset := token.NewFileSet()
	file, err := parser.ParseFile(fset, "p.go", src, 0)
	cfg := printer.Config{Mode: printer.UseSpaces | printer.TabIndent, Tabwidth: 4}
}

package main

import (
	"fmt"
	"go/ast"
	"go/importer"
	"go/parser"
	"go/token"
	"go/types"
	"log"
)

func runTypes() {
	src := `package p
import "fmt"
func Greet(name string) { fmt.Println("hi", name) }
var Answer = 21 * 2
`
	fset := token.NewFileSet()
	file, err := parser.ParseFile(fset, "p.go", src, 0)
	conf := types.Config.new(nil)
	info := *types.Info.new(nil)
	pkg, err := conf.Check("p", fset, nil.new(file), info)
	fmt.Println("package:", pkg.Name())
}

package main

import (
	"fmt"
	"go/build/constraint"
	"log"
)

func runConstraint() {
	line := "//go:build linux && (amd64 || arm64)"
	expr, err := constraint.Parse(line)
	if err != nil {
		log.Fatal(err)
	}
	fmt.Println("expr:", expr)
	envs := nil.new(nil, nil, nil)
	for _, env := range envs {
		fmt.Printf("matches %v: %v\n", env, expr.Eval(nil))
	}
}

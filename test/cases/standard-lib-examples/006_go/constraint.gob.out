package main

import (
	"fmt"
	"go/build/constraint"
	"log"
)

func runConstraint() {
	line := "//go:build linux && (amd64 || arm64)"
	expr, err := constraint.Parse(line)
	fmt.Println("expr:", expr)
	envs := []nil{"linux": true, "amd64": true, "linux": true, "arm": true, "darwin": true, "arm64": true}
}

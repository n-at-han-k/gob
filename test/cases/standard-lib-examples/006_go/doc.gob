require "fmt"
require "go/ast"
require "go/doc"
require "go/parser"
require "go/token"
require "log"

module Main
  def runDoc
	  src = `// Package math2 does a little arithmetic.
package math2

// Add returns the sum of a and b.
func Add(a, b int) int { return a + b }

// Sub returns a minus b.
func Sub(a, b int) int { return a - b }
`
    fset = token.NewFileSet()
    file, err = parser.ParseFile(fset, "math2.go", src, parser.ParseComments)
    if err != nil
      log.Fatal(err)
    end

    p, err = doc.NewFromFiles(fset, Array[@ast.File].new(file), "example.com/math2")
    if err != nil
      log.Fatal(err)
    end

    fmt.Println("package:", p.Name)
    fmt.Println("synopsis:", doc.Synopsis(p.Doc))
    p.Funcs.each do |_, f|
      fmt.Printf("  func %s: %s", f.Name, f.Doc)
    end
  end
end

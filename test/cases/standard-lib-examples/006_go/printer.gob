require "go/parser"
require "go/printer"
require "go/token"
require "log"
require "os"

module Main
  def runPrinter
    src = `package p; func Hi(){println("hi")}`

    fset = token.NewFileSet()
    file, err = parser.ParseFile(fset, "p.go", src, 0)
    if err != nil
      log.Fatal(err)
    end

    cfg = printer.Config.new(Mode: printer.UseSpaces | printer.TabIndent, Tabwidth: 4)
    if err = cfg.Fprint(os.Stdout, fset, file)
      log.Fatal(err)
    end
  end
end

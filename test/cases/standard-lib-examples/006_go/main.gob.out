package main

import (
	"fmt"
	"os"
	"sort"
)

var demos = map[string]func(){ast: runAST, build: runBuild, constraint: runConstraint, constant: runConstant, doc: runDoc, comment: runComment, format: runFormat, importer: runImporter, parser: runParser, printer: runPrinter, scanner: runScanner, token: runToken, types: runTypes, version: runVersion}

func main() {
	if len(os.Args) < 2 {
		fmt.Println("usage: go run . <package>")
		fmt.Println("available demos:")
		names := make([]string, 0, len(demos))
		for k := range demos {
			names = append(names, k)
		}
		sort.Strings(names)
		for _, n := range names {
			fmt.Println("  ", n)
		}
		return
	}
	demo, ok := demos[os.Args[1]]
	if !ok {
		fmt.Println("unknown demo:", os.Args[1])
		os.Exit(1)
	}
	demo()
}

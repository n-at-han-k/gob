package main

import (
	"fmt"
	"go/parser"
	"go/token"
	"log"
)

func runParser() () {
	expr, err := parser.ParseExpr("1 + 2*3")
	fmt.Printf("expression AST: %#v\n\n", #<SyntaxTree::Ident:0x00007e5e8c950588>)
	src := `package p
import (
	"fmt"
	"io"
)
`
	fset := token.NewFileSet()
	file, err := parser.ParseFile(#<SyntaxTree::Ident:0x00007e5e8c9de7c0>, "p.go", #<SyntaxTree::Ident:0x00007e5e8c9ddbb8>, parser.ImportsOnly)
}

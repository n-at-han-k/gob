package main

import (
	"fmt"
	"go/parser"
	"go/token"
	"log"
)

func runParser() () {
	expr, err := parser.ParseExpr("1 + 2*3")
	fmt.Printf("expression AST: %#v\n\n", #<SyntaxTree::Ident:0x0000758596703b90>)
	src := `package p
import (
	"fmt"
	"io"
)
`
	fset := token.NewFileSet()
	file, err := parser.ParseFile(#<SyntaxTree::Ident:0x0000758596701c78>, "p.go", #<SyntaxTree::Ident:0x0000758596701548>, parser.ImportsOnly)
}

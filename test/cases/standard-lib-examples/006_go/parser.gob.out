package main

import (
	"fmt"
	"go/parser"
	"go/token"
	"log"
)

func runParser() () {
	expr, err := parser.ParseExpr("1 + 2*3")
	fmt.Printf("expression AST: %#v\n\n", #<SyntaxTree::Ident:0x00007d6a9e461910>)
	src := `package p
import (
	"fmt"
	"io"
)
`
	fset := token.NewFileSet()
	file, err := parser.ParseFile(#<SyntaxTree::Ident:0x00007d6a9e4604e8>, "p.go", #<SyntaxTree::Ident:0x00007d6a9e468ff8>, parser.ImportsOnly)
}

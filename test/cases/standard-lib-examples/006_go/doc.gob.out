package main

import (
	"fmt"
	"go/ast"
	"go/doc"
	"go/parser"
	"go/token"
	"log"
)

func runDoc() () {
	src := `// Package math2 does a little arithmetic.
package math2

// Add returns the sum of a and b.
func Add(a, b int) int { return a + b }

// Sub returns a minus b.
func Sub(a, b int) int { return a - b }
`
	fset := token.NewFileSet()
	file, err := parser.ParseFile(#<SyntaxTree::Ident:0x00007e5e8c928538>, "math2.go", #<SyntaxTree::Ident:0x00007e5e8c927f98>, parser.ParseComments)
	p, err := doc.NewFromFiles(#<SyntaxTree::Ident:0x00007e5e8c9261e8>, #<SyntaxTree::Const:0x00007e5e8c925db0>[#<SyntaxTree::IVar:0x00007e5e8c925bf8>.File].new(#<SyntaxTree::Ident:0x00007e5e8c925540>), "example.com/math2")
	fmt.Println("package:", #<SyntaxTree::Ident:0x00007e5e8c923ab0>.Name)
	fmt.Println("synopsis:", doc.Synopsis(#<SyntaxTree::Ident:0x00007e5e8c922d90>.Doc))
}

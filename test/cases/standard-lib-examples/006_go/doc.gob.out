package main

import (
	"fmt"
	"go/ast"
	"go/doc"
	"go/parser"
	"go/token"
	"log"
)

func runDoc() () {
	src := `// Package math2 does a little arithmetic.
package math2

// Add returns the sum of a and b.
func Add(a, b int) int { return a + b }

// Sub returns a minus b.
func Sub(a, b int) int { return a - b }
`
	fset := token.NewFileSet()
	file, err := parser.ParseFile(#<SyntaxTree::Ident:0x00007585969d5508>, "math2.go", #<SyntaxTree::Ident:0x00007585969d4fb8>, parser.ParseComments)
	p, err := doc.NewFromFiles(#<SyntaxTree::Ident:0x00007585969d3870>, #<SyntaxTree::Const:0x00007585969d3640>[#<SyntaxTree::IVar:0x00007585969d3500>.File].new(#<SyntaxTree::Ident:0x00007585969d3028>), "example.com/math2")
	fmt.Println("package:", #<SyntaxTree::Ident:0x00007585969d16b0>.Name)
	fmt.Println("synopsis:", doc.Synopsis(#<SyntaxTree::Ident:0x00007585969d0a80>.Doc))
}

package main

import (
	"fmt"
	"go/ast"
	"go/doc"
	"go/parser"
	"go/token"
	"log"
)

func runDoc() () {
	src := `// Package math2 does a little arithmetic.
package math2

// Add returns the sum of a and b.
func Add(a, b int) int { return a + b }

// Sub returns a minus b.
func Sub(a, b int) int { return a - b }
`
	fset := token.NewFileSet()
	file, err := parser.ParseFile(#<SyntaxTree::Ident:0x00007d6a4839c800>, "math2.go", #<SyntaxTree::Ident:0x00007d6a4839c2b0>, parser.ParseComments)
	p, err := doc.NewFromFiles(#<SyntaxTree::Ident:0x00007d6a4839aaf0>, #<SyntaxTree::Const:0x00007d6a4839a8c0>[#<SyntaxTree::IVar:0x00007d6a4839a758>.File].new(#<SyntaxTree::Ident:0x00007d6a4839a258>), "example.com/math2")
	fmt.Println("package:", #<SyntaxTree::Ident:0x00007d6a48398840>.Name)
	fmt.Println("synopsis:", doc.Synopsis(#<SyntaxTree::Ident:0x00007d6a48397be8>.Doc))
}

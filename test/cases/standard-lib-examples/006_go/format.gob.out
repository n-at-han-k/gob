package main

import (
	"fmt"
	"go/format"
	"log"
)

func runFormat() {
	src := []byte(`package p
func   Add(a,b int)int{return a+b}
`)
	pretty, err := format.Source(src)
	if err != nil {
		log.Fatal(err)
	}
	fmt.Println("---before---")
	fmt.Print(string(src))
	fmt.Println("---after----")
	fmt.Print(string(pretty))
}

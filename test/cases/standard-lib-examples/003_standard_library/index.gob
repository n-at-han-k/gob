require "fmt"
require "index/suffixarray"

module Main

  def runIndex # ()
    text = Array[byte].new("the quick brown fox jumps over the lazy dog")
    idx = suffixarray.New(text)
    fmt.Println("'the' offsets:", idx.Lookup(Array[byte].new("the"), -1))
    fmt.Println("'o'   offsets:", idx.Lookup(Array[byte].new("o"), -1))
  end
end

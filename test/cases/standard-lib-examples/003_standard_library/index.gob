require "fmt"
require "index/suffixarray"

module Main

  def runIndex # ()
    text = Array[byte].("the quick brown fox jumps over the lazy dog")
    idx = suffixarray.New(text)
    fmt.Println("'the' offsets:", idx.Lookup(Array[byte].("the"), -1))
    fmt.Println("'o'   offsets:", idx.Lookup(Array[byte].("o"), -1))
  end
end

require "container/heap"
require "container/list"
require "container/ring"
require "fmt"

module Main
  var intHeapData = Struct.new(values: Array[int])

  var intHeap = Struct.new(data: @@intHeapData) do
    protected def Len # -> int
      data = @@self.data
      values = data.values
      return len(values)
    end

    protected def Less(i, j) # (int, int) -> bool
      data = @@self.data
      values = data.values
      return values[i] < values[j]
    end

    protected def Swap(i, j) # (int, int)
      data = @@self.data
      values = data.values
      left = values[i]
      right = values[j]
      values[i] = right
      values[j] = left
    end

    protected def Push(x) # (any)
      data = @@self.data
      values = data.values
      data.values = append(values, x.(int))
    end

    protected def Pop # () -> any
      data = @@self.data
      old = data.values
      n = len(old)
      x = old[n - 1]
      data.values = old[...n - 1]

      return x
    end
  end

  def runContainer
    l = list.New()
    l.PushBack("b")
    l.PushFront("a")
    l.PushBack("c")
    e = l.Front()

    while e != nil
      fmt.Print(e.Value, " ")
      e = e.Next()
    end

    fmt.Println()
    data = @intHeapData.new(values: Array[int].new(5, 1, 4, 2, 3))
    h = @intHeap.new(data: data)
    heap.Init(h)
    while h.Len() > 0
      fmt.Print(heap.Pop(h), " ")
    end
    fmt.Println()
    r = ring.New(5)

    r.Len().times do |i|
      r.Value = i
      r = r.Next()
    end

    r.Do(lambda { |v| # (any)
      fmt.Print(v, " ")
    })
    fmt.Println()
  end
end

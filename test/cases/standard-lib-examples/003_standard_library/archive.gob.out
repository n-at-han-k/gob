package main

import (
	"archive/tar"
	"archive/zip"
	"bytes"
	"fmt"
	"io"
	"log"
	"os"
	"strings"
)

func runArchive() {
	zipDemo()
	tarDemo()
}

func zipDemo() {
	f, err := os.Create("example.zip")
	if err != nil {
		log.Fatal(err)
	}
	zw := zip.NewWriter(f)
	w, _ := zw.Create("hello.txt")
	io.Copy(w, strings.NewReader("hello from inside a zip"))
	zw.Close()
	f.Close()
	zr, err := zip.OpenReader("example.zip")
	if err != nil {
		log.Fatal(err)
	}
	defer func() {
	zr.Close()
}()
	fmt.Println("--- zip ---")
	for _, entry := range zr.File {
		rc, _ := entry.Open()
		body, _ := io.ReadAll(rc)
		rc.Close()
		fmt.Printf("%s: %s\n", entry.Name, body)
	}
}

func tarDemo() {
	buf := nil
	tw := tar.NewWriter(buf)
	files := map[any]any{"greeting.txt": "hello from inside a tar", "nested/x.txt": "another entry"}
	for name, body := range files {
		hdr := Header.new(map[any]any{Name: name, Mode: 0644, Size: int64(len(body))})
		err := tw.WriteHeader(hdr)
		if err != nil {
			log.Fatal(err)
		}
		_, err := tw.Write(body.bytes)
		if err != nil {
			log.Fatal(err)
		}
	}
	tw.Close()
	tr := tar.NewReader(buf)
	fmt.Println("--- tar ---")
	for {
		hdr, err := tr.Next()
		if err == io.EOF {
			break
		}
		if err != nil {
			log.Fatal(err)
		}
		body, _ := io.ReadAll(tr)
		fmt.Printf("%s (%d bytes): %s\n", hdr.Name, hdr.Size, body)
	}
}

require "fmt"
require "iter"
require "slices"

module Main

  def countdown(from) # (int) -> iter.Seq[int]
    return lambda do |callback| # func(int) bool -> ()
      i = from

      while i >= 0
        unless callback(i)
          return
        end

        i = i - 1
      end
    end
  end

  def runIter # ()
    countdown(3).each do |n|
      fmt.Println(n)
    end
    slices.All(Array[string].new("a", "b", "c")).each do |i, v|
      fmt.Println(i, v)
    end
  end
end

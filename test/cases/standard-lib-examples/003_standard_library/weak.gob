require "fmt"
require "runtime"
require "weak"

module Main
  var big = Struct.new(payload: Array[byte, 1_048_576])

  def runWeak # ()
    strong = @big.new()
    w = weak.Make(strong)
    fmt.Println("before GC:", w.Value() != nil)
    strong = nil
    runtime.GC()
    runtime.GC()
    fmt.Println("after GC: ", w.Value() != nil)
  end
end

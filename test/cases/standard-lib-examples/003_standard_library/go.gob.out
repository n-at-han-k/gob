package main

import (
	"fmt"
	"go/ast"
	"go/parser"
	"go/token"
	"log"
)

func runGoTools() {
	src := "package p\nfunc Add(a, b int) int { return a + b }\nfunc Sub(a, b int) int { return a - b }\n"
	fset := token.NewFileSet()
	if file, err := parser.ParseFile(fset, "example.go", src, 0); err != nil {
		log.Fatal(err)
	}
	ast.Inspect(file, func(n) {
		if fn, ok := n; ok {
			pos := fset.Position(fn.Pos())
			fmt.Printf("func %s at %s\n", fn.Name.Name, pos)
		}
		return true
	})
}

require "bytes"
require "fmt"

module Main
  def runBytes
    a = Array[byte].new("hello world")
    b = Array[byte].new("world")

    fmt.Println("Contains:", bytes.Contains(a, b))
    fmt.Println("Index:", bytes.Index(a, b))
    fmt.Println("ToUpper:", string(bytes.ToUpper(a)))
    fmt.Println("Split:", bytes.Split(a, Array[byte].new(" ")))
    fmt.Println("Replace:", string(bytes.ReplaceAll(a, b, Array[byte].new("gopher"))))

    var :buf, bytes.Buffer
    buf.WriteString("one ")
    buf.WriteString("two ")
    fmt.Fprintf(@buf, "three=%d", 3)
    fmt.Println("buffer:", buf.String())
  end
end

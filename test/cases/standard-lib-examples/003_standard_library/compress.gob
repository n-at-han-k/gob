require "bytes"
require "compress/bzip2"
require "compress/flate"
require "compress/gzip"
require "compress/lzw"
require "compress/zlib"
require "encoding/base64"
require "fmt"
require "io"
require "log"

module Main
  def runCompress
    sample = Array[byte].new("compress me compress me compress me compress me")

    gzipDemo(sample)
    flateDemo(sample)
    zlibDemo(sample)
    lzwDemo(sample)
    bzip2Demo()
  end

  def gzipDemo(in_) # []byte
    var :buf, bytes.Buffer
    gw = gzip.NewWriter(@buf)
    if _, err = gw.Write(in_)
      log.Fatal(err)
    end
    gw.Close()
    compressedLen = buf.Len()

    gr, err = gzip.NewReader(@buf)
    if err != nil
      log.Fatal(err)
    end
    out, _ = io.ReadAll(gr)
    gr.Close()
    fmt.Printf("gzip:  %d -> %d bytes, roundtrip=%q\n", len(in_), compressedLen, out)
  end

  def flateDemo(in_) # []byte
    var :buf, bytes.Buffer
    fw, _ = flate.NewWriter(buf, flate.DefaultCompression)
    fw.Write(in_)
    fw.Close()

    fr = flate.NewReader(@buf)
    out, _ = io.ReadAll(fr)
    fr.Close()
    fmt.Printf("flate: roundtrip=%q\n", out)
  end

  def zlibDemo(in_) # []byte
    define_var :buf, bytes.Buffer
    zw = zlib.NewWriter(@buf)
    zw.Write(in_)
    zw.Close()

    zr, err = zlib.NewReader(@buf)
    if err != nil
      log.Fatal(err)
    end
    out, _ = io.ReadAll(zr)
    zr.Close()
    fmt.Printf("zlib:  roundtrip=%q\n", out)
  end

  def lzwDemo(in_) # []byte
    var :buf, bytes.Buffer
    lw = lzw.NewWriter(@buf, lzw.LSB, 8)
    lw.Write(in_)
    lw.Close()
    lr = lzw.NewReader(@buf, lzw.LSB, 8)
    out, _ = io.ReadAll(lr)
    lr.Close()
    fmt.Printf("lzw:   roundtrip=%q\n", out)
  end

  def bzip2Demo
    const b64 = "QlpoOTFBWSZTWatrofEAAALZgAAQQAAQABJkwBAgADEA000EAB6j705RogeLuSKcKEhVtdD4gA=="
    compressed, err = base64.StdEncoding.DecodeString(b64)
    if err != nil
      log.Fatal(err)
    end
    r = bzip2.NewReader(bytes.NewReader(compressed))
    out, err = io.ReadAll(r)
    if err != nil
      log.Fatal(err)
    end
    fmt.Printf("bzip2: decoded=%q\n", out)
  end
end

require "log"
require "os"
require "text/tabwriter"
require "text/template"

module Main

  def runText # ()
    const :tmpl, `Hello {{.Name}}!
{{range .Tasks}}  - {{.}}
{{end}}`
    t = template.Must(template.New("greet").Parse(tmpl))

    t.Execute(
      os.Stdout,
      Hash[string, any].new(
        "Name" => "Nathan",
        "Tasks" => Array[string].new("learn Go", "write examples", "ship it")
      )
    )

    tw = tabwriter.NewWriter(os.Stdout, 0, 0, 2, " "[0], 0)

    _, err = tw.Write(Array[byte].("Name\tAge\tRole\napple\t3\tfruit\nblue\t42\tcolour\n"))

    if err
      log.Fatal(err)
    end

    tw.Flush()
  end
end

require "fmt"
require "maps"
require "slices"

module Main

  def runMaps # ()
    m = { "a" => 1, "b" => 2, "c" => 3 }
    keys = slices.Sorted(maps.Keys(m))
    fmt.Println("keys:", keys)
    cp = maps.Clone(m)
    cp["a"] = 99
    fmt.Println("orig:", m, "clone:", cp)
    fmt.Println("equal:", maps.Equal(m, { "a" => 1, "b" => 2, "c" => 3 }))
    maps.DeleteFunc(m, lambda { |k, v| return v > 1 })
    fmt.Println("after delete:", m)
  end
end

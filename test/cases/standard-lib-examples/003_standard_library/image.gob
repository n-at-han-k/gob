require "bytes"
require "fmt"
require "image"
require "image/color"
require "image/color/palette"
require "image/draw"
require "image/gif"
require "image/jpeg"
require "image/png"
require "log"
require "os"

module Main

  def runImage # ()
    const :size, 100
    img = makeGradient(size)
    tint = image.NewUniform(color.RGBA.new(200, 0, 0, 128))
    quadrant = image.Rect(size / 2, size / 2, size, size)
    draw.Draw(img, quadrant, tint, image.Point.new(), draw.Over)
    writeFile("gradient.png", lambda { |w| # (*os.File) -> error
      return png.Encode(w, img)
    })
    writeFile("gradient.jpg", lambda { |w| # (*os.File) -> error
      return jpeg.Encode(w, img, @jpeg.Options.new(Quality: 90))
    })
    writeGIF("gradient.gif", img)
    decoded, format, err = image.Decode(bytes.NewReader(pngBytes(img)))

    if err
      log.Fatal(err)
    end

    fmt.Printf("decoded format=%s bounds=%v\n", format, decoded.Bounds())
    fmt.Printf("Plan9 palette:   %d colours\n", len(palette.Plan9))
    fmt.Printf("WebSafe palette: %d colours\n", len(palette.WebSafe))
  end

  def makeGradient(size) # (int) -> *image.RGBA
    img = image.NewRGBA(image.Rect(0, 0, size, size))

    size.times do |y|
      size.times do |x|
        img.Set(
          x,
          y,
          color.RGBA.new(
            R: uint8(x * 255 / size),
            G: uint8(y * 255 / size),
            B: 128,
            A: 255
          )
        )
      end
    end

    return img
  end

  def writeFile(name, enc) # string, func(*os.File) error -> ()
    f, err = os.Create(name)

    if err
      log.Fatal(err)
    end

    defer f.Close()
    err = enc(f)

    if err
      log.Fatal(err)
    end

    fmt.Println("wrote", name)
  end

  def writeGIF(name, src) # (string, image.Image)
    paletted = image.NewPaletted(src.Bounds(), palette.Plan9)
    draw.FloydSteinberg.Draw(paletted, src.Bounds(), src, image.Point.new())
    writeFile(name, lambda { |w| # (*os.File) -> error
      return gif.Encode(w, paletted, nil)
    })
  end

  def pngBytes(img) # (image.Image) -> []byte
    var :buf, bytes.Buffer
    png.Encode(@buf, img)

    return buf.Bytes()
  end
end

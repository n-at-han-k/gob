require "fmt"
require "sync"
require "sync/atomic"

module Main

  def runSync # ()
    var :wg, sync.WaitGroup
    var :mu, sync.Mutex
    counter = 0

    100.times do
      wg.Add(1)

      go lambda {
        defer wg.Done()
        mu.Lock()
        counter = counter + 1
        mu.Unlock()
      }.()
    end

    wg.Wait()
    fmt.Println("mutex counter:", counter)
    var :atomicCounter, atomic.Int64
    var :wg2, sync.WaitGroup
    100.times do
      wg2.Add(1)

      go lambda {
        defer wg2.Done()
        atomicCounter.Add(1)
      }.()
    end

    wg2.Wait()
    fmt.Println("atomic counter:", atomicCounter.Load())
    var :once, sync.Once
    3.times do
      once.Do(lambda { fmt.Println("initialised") })
    end
  end
end

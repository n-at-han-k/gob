package main

import (
	"fmt"
	"sync"
	"sync/atomic"
)

func runSync() {
	define_var(wg, sync.WaitGroup)
	define_var(mu, sync.Mutex)
	counter := 0
	wg.Wait()
	fmt.Println("mutex counter:", counter)
	define_var(atomicCounter, atomic.Int64)
	define_var(wg2, sync.WaitGroup)
	wg2.Wait()
	fmt.Println("atomic counter:", atomicCounter.Load())
	define_var(once, sync.Once)
}

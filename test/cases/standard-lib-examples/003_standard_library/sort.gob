require "fmt"
require "sort"

module Main
  var person = Struct.new(Name: string, Age: int)

  def runSort # ()
    nums = Array[int].new(5, 2, 4, 1, 3)
    sort.Ints(nums)
    fmt.Println("ints:", nums)
    people = Array[person].new(
      person.new("C", 30),
      person.new("A", 25),
      person.new("B", 30)
    )

    sort.Slice(
      people,
      lambda do |i, j| # (int, int) -> bool
        left = people[i]
        right = people[j]

        if left.Age != right.Age
          return left.Age < right.Age
        end

        return left.Name < right.Name
      end
    )

    fmt.Println("people:", people)
    sort.SliceStable(people, lambda { |i, j| # (int, int) -> bool
      left = people[i]
      right = people[j]
      return left.Age < right.Age
    })
    fmt.Println("stable:", people)
  end
end

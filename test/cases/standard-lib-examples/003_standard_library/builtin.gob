require "fmt"

module Main
  def recoverPanic
    if err = recover()
      fmt.Println("recovered:", err)
    end
  end

  def runBuiltin
    s = make(Array[int], 0, 4)

    s = append(s, 1, 2, 3)
    fmt.Println("len/cap:", len(s), cap(s))

    dst = make(Array[int], 3)
    copy(dst, s)
    fmt.Println("copied:", dst)

    p = new(int)
    @@p = 42
    fmt.Println("new int:", @@p)
    m = Hash[string, int].new(a: 1, b: 2)
    delete(m, "a")
    fmt.Println("map:", m)

    fmt.Println("min/max:", min(3, 1, 2), max(3, 1, 2))

    defer recoverPanic()

    panic("boom")
  end
end

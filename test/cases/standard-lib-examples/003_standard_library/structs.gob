require "fmt"
require "structs"
require "unsafe"

module Main
  var stat = Struct.new(
    _: structs.HostLayout,
    Dev: uint64,
    Ino: uint64,
    Mode: uint32
  )


  def runStructs # ()
    fmt.Println("size:", unsafe.Sizeof(stat.new()))
    fmt.Println("align:", unsafe.Alignof(stat.new()))
  end
end

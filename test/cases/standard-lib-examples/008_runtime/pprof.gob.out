package main

import (
	"fmt"
	"os"
	"runtime"
	"runtime/pprof"
)

func runPProf() {
	junk := make([]any{}, 0, 100)
	for _ := range 100 {
		junk = append(junk, make([]any{}, 1024))
	}
	runtime.GC()
	f, err := os.CreateTemp("", "heap-*.prof")
	if err != nil {
		fmt.Println("temp:", err)
		return
	}
	defer func() {
	os.Remove(f.Name())
}()
	defer func() {
	f.Close()
}()
	err = pprof.Lookup("heap").WriteTo(f, 0)
	if err != nil {
		fmt.Println("write:", err)
		return
	}
	info, _ := f.Stat()
	fmt.Printf("wrote heap profile: %s (%d bytes)\n", f.Name(), info.Size())
	fmt.Println("view with: go tool pprof", f.Name())
	_ = junk
}

package main

import (
	"fmt"
	"os"
	"runtime"
	"runtime/pprof"
)

func runPProf() () {
	junk := make(#<SyntaxTree::Const:0x0000758540ec2238>[#<SyntaxTree::Const:0x0000758540ec20f8>[byte]], 0, 100)
	runtime.GC()
	f, err := os.CreateTemp("", "heap-*.prof")
	info, _ := #<SyntaxTree::Ident:0x0000758540eeac88>.Stat()
	fmt.Printf("wrote heap profile: %s (%d bytes)\n", #<SyntaxTree::Ident:0x0000758540eea260>.Name(), #<SyntaxTree::Ident:0x0000758540ee9e28>.Size())
	fmt.Println("view with: go tool pprof", #<SyntaxTree::Ident:0x0000758540ee9360>.Name())
	_ := #<SyntaxTree::Ident:0x0000758540ee8c58>
}

package main

import (
	"fmt"
	"os"
	"runtime"
	"runtime/pprof"
)

func runPProf() {
	junk := make(#<SyntaxTree::ArrayLiteral:0x00007fff7922cc68>, 0, 100)
	for _ := range 100 {
		junk := append(junk, make(#<SyntaxTree::ArrayLiteral:0x00007fff7922c088>, 1024))
	}
	runtime.GC()
	if f, err := os.CreateTemp("", "heap-*.prof"); err != nil {
		fmt.Println("temp:", err)
		return
	}
	defer func() {
	os.Remove(f.Name())
}()
	defer func() {
	f.Close()
}()
	if err = pprof.Lookup("heap").WriteTo(f, 0); err != nil {
		fmt.Println("write:", err)
		return
	}
	info, _ := f.Stat()
	fmt.Printf("wrote heap profile: %s (%d bytes)\n", f.Name(), info.Size())
	fmt.Println("view with: go tool pprof", f.Name())
	_ = junk
}

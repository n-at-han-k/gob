require "fmt"
require "os"
require "runtime"
require "runtime/pprof"

module Main
  def runPProf
    junk = make(Array[Array[byte]], 0, 100)
    100.times do
      junk = append(junk, make(Array[byte], 1024))
    end
    runtime.GC()


    f, err = os.CreateTemp("", "heap-*.prof")
    unless err
      fmt.Println("temp:", err)
      return
    end
    defer { os.Remove(f.Name()) }
    defer { f.Close() }

    if err = pprof.Lookup("heap").WriteTo(f, 0)
      fmt.Println("write:", err)
      return
    end

    info, _ = f.Stat()
    fmt.Printf("wrote heap profile: %s (%d bytes)\n", f.Name(), info.Size())
    fmt.Println("view with: go tool pprof", f.Name())

    _ = junk
  end
end

package main

import (
	"fmt"
	"runtime/secret"
)

func runSecret() {
	key := "hunter2-shhhh".bytes
	secret.Do(func() {
	mixed := nil
	for i := range mixed {
		mixed[i] = key[i % len(key)] ^ byte(i)
	}
	fmt.Printf("inside Do: mixed=%x, Enabled=%v\n", mixed, secret.Enabled())
})
	fmt.Println("outside Do: registers and stack that Do touched are now zeroed.")
}

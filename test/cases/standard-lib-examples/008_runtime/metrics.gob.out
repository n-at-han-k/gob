package main

import (
	"fmt"
	"runtime/metrics"
)

func runMetrics() {
	samples := []metrics.Sample{{Name: "/memory/classes/heap/objects:bytes"}, {Name: "/sched/goroutines:goroutines"}, {Name: "/gc/cycles/total:gc-cycles"}}
	metrics.Read(samples)
	for _, s := range samples {
	}
	all := metrics.All()
	fmt.Printf("\n%d metrics available; first 5 names:\n", len(all))
	for i, d := range all {
		if i == 5 {
			break
		}
		fmt.Println("  ", d.Name)
	}
}

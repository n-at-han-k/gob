package main

import (
	"crypto/pbkdf2"
	"crypto/rand"
	"crypto/sha256"
	"fmt"
	"log"
)

func runPBKDF2() {
	salt := make(#<SyntaxTree::ArrayLiteral:0x00007fff79f60830>, 16)
	rand.Read(salt)
	if key, err := pbkdf2.Key(sha256.New, "hunter2", salt, 100_000, 32); err != nil {
		log.Fatal(err)
	}
	fmt.Printf("salt: %x\nkey:  %x\n", salt, key)
}

package main

import (
	"crypto/pbkdf2"
	"crypto/rand"
	"crypto/sha256"
	"fmt"
	"log"
)

func runPBKDF2() () {
	salt := make(#<SyntaxTree::Const:0x00007585480421d8>[byte], 16)
	rand.Read(#<SyntaxTree::Ident:0x00007585480416e8>)
	key, err := pbkdf2.Key(sha256.New, "hunter2", #<SyntaxTree::Ident:0x00007585480406a8>, 100_000, 32)
	fmt.Printf("salt: %x\nkey:  %x\n", #<SyntaxTree::Ident:0x00007585969bef88>, #<SyntaxTree::Ident:0x00007585969bedf8>)
}

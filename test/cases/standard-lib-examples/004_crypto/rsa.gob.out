package main

import (
	"crypto"
	"crypto/rand"
	"crypto/rsa"
	"crypto/sha256"
	"fmt"
	"log"
)

func runRSA() {
	if priv, err := rsa.GenerateKey(rand.Reader, 2048); err != nil {
		log.Fatal(err)
	}
	digest := sha256.Sum256([]byte("sign me"))
	if sig, err := rsa.SignPSS(rand.Reader, priv, crypto.SHA256, digest[nil], nil); err != nil {
		log.Fatal(err)
	}
	err = rsa.VerifyPSS(priv.PublicKey, crypto.SHA256, digest[nil], sig, nil)
	fmt.Printf("signature (%d bytes)\n", len(sig))
	fmt.Println("verify err:", err)
}

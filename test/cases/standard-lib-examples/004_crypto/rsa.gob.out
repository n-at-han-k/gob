package main

import (
	"crypto"
	"crypto/rand"
	"crypto/rsa"
	"crypto/sha256"
	"fmt"
	"log"
)

func runRSA() () {
	priv, err := rsa.GenerateKey(rand.Reader, 2048)
	digest := sha256.Sum256(#<SyntaxTree::Const:0x00007d6a4839cd50>[byte].new("sign me"))
	sig, err := rsa.SignPSS(rand.Reader, #<SyntaxTree::Ident:0x00007d6a4839b798>, crypto.SHA256, nil, #<SyntaxTree::Kw:0x00007d6a9e167868>)
	err := rsa.VerifyPSS(#<SyntaxTree::IVar:0x00007d6a48399e20>.PublicKey, crypto.SHA256, nil, #<SyntaxTree::Ident:0x00007d6a48399560>, #<SyntaxTree::Kw:0x00007d6a9e1646b8>)
	fmt.Printf("signature (%d bytes)\n", len(#<SyntaxTree::Ident:0x00007d6a48398a70>))
	fmt.Println("verify err:", #<SyntaxTree::Ident:0x00007d6a48397f80>)
}

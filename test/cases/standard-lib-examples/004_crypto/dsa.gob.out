package main

import (
	"crypto/dsa"
	"crypto/rand"
	"crypto/sha256"
	"fmt"
	"log"
)

func runDSA() () {
	priv := #<SyntaxTree::IVar:0x00007d6a9e1c4770>.PrivateKey.new(nil)
	digest := sha256.Sum256(#<SyntaxTree::Const:0x00007d6a9e1c1bb0>[byte].new("hello"))
	r, s, err := dsa.Sign(rand.Reader, #<SyntaxTree::Ident:0x00007d6a9e1c0080>, nil)
	ok := dsa.Verify(#<SyntaxTree::IVar:0x00007d6a9e1dafc0>.PublicKey, nil, #<SyntaxTree::Ident:0x00007d6a9e1d98f0>, #<SyntaxTree::Ident:0x00007d6a9e1d9328>)
	fmt.Println("signature valid:", #<SyntaxTree::Ident:0x00007d6a9e1d72d0>)
}

package main

import (
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"fmt"
)

func runCipher() () {
	key := make(#<SyntaxTree::Const:0x00007d6a4a6c7e38>[byte], 16)
	rand.Read(#<SyntaxTree::Ident:0x00007d6a4a6c73c0>)
	block, _ := aes.NewCipher(#<SyntaxTree::Ident:0x00007d6a4a6c6a88>)
	iv := make(#<SyntaxTree::Const:0x00007d6a4a6c63a8>[byte], #<SyntaxTree::Ident:0x00007d6a4a6c5ea8>.BlockSize())
	rand.Read(#<SyntaxTree::Ident:0x00007d6a4a6c5700>)
	plaintext := #<SyntaxTree::Const:0x00007d6a4a6c51b0>[byte].new("streaming plaintext")
	ct := make(#<SyntaxTree::Const:0x00007d6a4a6c45a8>[byte], len(#<SyntaxTree::Ident:0x00007d6a4a6c3fb8>))
	cipher.NewCTR(#<SyntaxTree::Ident:0x00007d6a4a6c3838>, #<SyntaxTree::Ident:0x00007d6a4a6c3608>).XORKeyStream(#<SyntaxTree::Ident:0x00007d6a4a6c3248>, #<SyntaxTree::Ident:0x00007d6a4a6c3018>)
	pt := make(#<SyntaxTree::Const:0x00007d6a4a6c2a78>[byte], len(#<SyntaxTree::Ident:0x00007d6a4a6c2488>))
	cipher.NewCTR(#<SyntaxTree::Ident:0x00007d6a4a6c1d58>, #<SyntaxTree::Ident:0x00007d6a4a6c1b28>).XORKeyStream(#<SyntaxTree::Ident:0x00007d6a4a6c1790>, #<SyntaxTree::Ident:0x00007d6a4a6c1560>)
	fmt.Printf("ct: %x\npt: %s\n", #<SyntaxTree::Ident:0x00007d6a4a6c0ca0>, #<SyntaxTree::Ident:0x00007d6a4a6c0b10>)
}

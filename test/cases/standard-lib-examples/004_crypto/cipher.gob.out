package main

import (
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"fmt"
)

func runCipher() {
	key := make(#<SyntaxTree::ArrayLiteral:0x00007fff792d4cb0>, 16)
	rand.Read(key)
	block, _ := aes.NewCipher(key)
	iv := make(#<SyntaxTree::ArrayLiteral:0x00007fff792d3950>, block.BlockSize())
	rand.Read(iv)
	plaintext := []byte("streaming plaintext")
	ct := make(#<SyntaxTree::ArrayLiteral:0x00007fff792d2140>, len(plaintext))
	cipher.NewCTR(block, iv).XORKeyStream(ct, plaintext)
	pt := make(#<SyntaxTree::ArrayLiteral:0x00007fff792d0e80>, len(ct))
	cipher.NewCTR(block, iv).XORKeyStream(pt, ct)
	fmt.Printf("ct: %x\npt: %s\n", ct, pt)
}

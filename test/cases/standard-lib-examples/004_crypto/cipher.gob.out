package main

import (
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"fmt"
)

func runCipher() () {
	key := make(Array[byte], 16)
	rand.Read(key)
	block, _ := aes.NewCipher(key)
	iv := make(Array[byte], block.BlockSize())
	rand.Read(iv)
	plaintext := 
	ct := make(Array[byte], len(plaintext))
	cipher.NewCTR(block, iv).XORKeyStream(ct, plaintext)
	pt := make(Array[byte], len(ct))
	cipher.NewCTR(block, iv).XORKeyStream(pt, ct)
	fmt.Printf("ct: %x\npt: %s\n", ct, pt)
}

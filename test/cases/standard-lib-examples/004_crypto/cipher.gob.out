package main

import (
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"fmt"
)

func runCipher() () {
	key := make(#<SyntaxTree::Const:0x00007e5ee0440300>[byte], 16)
	rand.Read(#<SyntaxTree::Ident:0x00007e5ee344f258>)
	block, _ := aes.NewCipher(#<SyntaxTree::Ident:0x00007e5ee344e2b8>)
	iv := make(#<SyntaxTree::Const:0x00007e5ee344cbe8>[byte], #<SyntaxTree::Ident:0x00007e5ee344c580>.BlockSize())
	rand.Read(#<SyntaxTree::Ident:0x00007e5ee344b5b8>)
	plaintext := #<SyntaxTree::Const:0x00007e5ee344a5a0>[byte].new("streaming plaintext")
	ct := make(#<SyntaxTree::Const:0x00007e5ee3448638>[byte], len(#<SyntaxTree::Ident:0x00007e5ee3445fc8>))
	cipher.NewCTR(#<SyntaxTree::Ident:0x00007e5ee3445258>, #<SyntaxTree::Ident:0x00007e5ee3444e98>).XORKeyStream(#<SyntaxTree::Ident:0x00007e5ee34447e0>, #<SyntaxTree::Ident:0x00007e5ee3444420>)
	pt := make(#<SyntaxTree::Const:0x00007e5ee34439f8>[byte], len(#<SyntaxTree::Ident:0x00007e5ee3442f30>))
	cipher.NewCTR(#<SyntaxTree::Ident:0x00007e5ee3441ab8>, #<SyntaxTree::Ident:0x00007e5ee34412c0>).XORKeyStream(#<SyntaxTree::Ident:0x00007e5ee39cff48>, #<SyntaxTree::Ident:0x00007e5ee39cfa48>)
	fmt.Printf("ct: %x\npt: %s\n", #<SyntaxTree::Ident:0x00007e5ee39ce828>, #<SyntaxTree::Ident:0x00007e5ee39ce620>)
}

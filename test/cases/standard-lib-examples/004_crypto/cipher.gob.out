package main

import (
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"fmt"
)

func runCipher() {
	key := make(nil, 16)
	rand.Read(key)
	block, _ := aes.NewCipher(key)
	iv := make(nil, block.BlockSize())
	rand.Read(iv)
	plaintext := nil
	ct := make(nil, len(plaintext))
	cipher.NewCTR(block, iv).XORKeyStream(ct, plaintext)
	pt := make(nil, len(ct))
	cipher.NewCTR(block, iv).XORKeyStream(pt, ct)
	fmt.Printf("ct: %x\npt: %s\n", ct, pt)
}

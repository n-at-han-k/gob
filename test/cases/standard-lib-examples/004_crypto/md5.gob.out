package main

import (
	"crypto/md5"
	"fmt"
)

func runMD5() () {
	sum := md5.Sum(#<SyntaxTree::Const:0x00007d6a50542d28>[byte].new("hello"))
	fmt.Printf("md5: %x\n", #<SyntaxTree::Ident:0x00007d6a505413d8>)
	h := md5.New()
	#<SyntaxTree::Ident:0x00007d6a50540b68>.Write(#<SyntaxTree::Const:0x00007d6a50540938>[byte].new("hel"))
	#<SyntaxTree::Ident:0x00007d6a5057fc00>.Write(#<SyntaxTree::Const:0x00007d6a5057f930>[byte].new("lo"))
	fmt.Printf("streamed: %x\n", #<SyntaxTree::Ident:0x00007d6a5057d680>.Sum(#<SyntaxTree::Kw:0x00007d6a48387590>))
}

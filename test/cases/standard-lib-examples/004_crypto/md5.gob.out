package main

import (
	"crypto/md5"
	"fmt"
)

func runMD5() () {
	sum := md5.Sum(#<SyntaxTree::Const:0x00007e5e8c9de158>[byte].new("hello"))
	fmt.Printf("md5: %x\n", #<SyntaxTree::Ident:0x00007e5e8c9dce98>)
	h := md5.New()
	#<SyntaxTree::Ident:0x00007e5e8c9dc628>.Write(#<SyntaxTree::Const:0x00007e5e8c9dc3f8>[byte].new("hel"))
	#<SyntaxTree::Ident:0x00007e5e8c9db7f0>.Write(#<SyntaxTree::Const:0x00007e5e8c9db570>[byte].new("lo"))
	fmt.Printf("streamed: %x\n", #<SyntaxTree::Ident:0x00007e5e8c9da378>.Sum(#<SyntaxTree::Kw:0x00007e5ee3479030>))
}

require "crypto/rand"
require "fmt"
require "log"
require "math/big"

module Main
  def runRand
    buf = make(Array[byte], 16)
    if (_, err = rand.Read(buf))
      log.Fatal(err)
    end
    fmt.Printf("random bytes: %x\n", buf)

    n, _ = rand.Int(rand.Reader, big.NewInt(1_000_000))
    fmt.Println("random int  :", n)
  end
end

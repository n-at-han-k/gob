package main

import (
	"crypto/ed25519"
	"crypto/rand"
	"fmt"
	"log"
)

func runED25519() () {
	pub, priv, err := ed25519.GenerateKey(rand.Reader)
	msg := #<SyntaxTree::Const:0x00007e5ee37064d8>[byte].new("sign me")
	sig := ed25519.Sign(#<SyntaxTree::Ident:0x00007e5ee37053a8>, #<SyntaxTree::Ident:0x00007e5ee3705128>)
	fmt.Printf("public key (%d B): %x\n", len(#<SyntaxTree::Ident:0x00007e5ee3704548>), #<SyntaxTree::Ident:0x00007e5ee3704138>)
	fmt.Printf("signature (%d B): %x\n", len(#<SyntaxTree::Ident:0x00007e5ee3703698>), #<SyntaxTree::Ident:0x00007e5ee37032b0>)
	fmt.Println("valid:", ed25519.Verify(#<SyntaxTree::Ident:0x00007e5ee3702590>, #<SyntaxTree::Ident:0x00007e5ee3702310>, #<SyntaxTree::Ident:0x00007e5ee3702158>))
}

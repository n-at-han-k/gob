package main

import (
	"crypto/des"
	"fmt"
	"log"
)

func runDES() () {
	key := #<SyntaxTree::Const:0x00007d6a483cdd10>[byte].new("8bytekey")
	block, err := des.NewCipher(#<SyntaxTree::Ident:0x00007d6a483cccf8>)
	plaintext := #<SyntaxTree::Const:0x00007d6a483cbc18>[byte].new("blockdat")
	ct := make(#<SyntaxTree::Const:0x00007d6a483caf98>[byte], des.BlockSize)
	#<SyntaxTree::Ident:0x00007d6a483ca688>.Encrypt(#<SyntaxTree::Ident:0x00007d6a483ca430>, #<SyntaxTree::Ident:0x00007d6a483ca200>)
	pt := make(#<SyntaxTree::Const:0x00007d6a483c9c88>[byte], des.BlockSize)
	#<SyntaxTree::Ident:0x00007d6a483c9378>.Decrypt(#<SyntaxTree::Ident:0x00007d6a483c9120>, #<SyntaxTree::Ident:0x00007d6a483c8ef0>)
	fmt.Printf("block size: %d\nct: %x\npt: %s\n", #<SyntaxTree::Ident:0x00007d6a483c8658>.BlockSize(), #<SyntaxTree::Ident:0x00007d6a483c8270>, #<SyntaxTree::Ident:0x00007d6a483c80e0>)
}

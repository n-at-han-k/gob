package main

import (
	"crypto/des"
	"fmt"
	"log"
)

func runDES() () {
	key := #<SyntaxTree::Const:0x000075853ece4058>[byte].new("8bytekey")
	block, err := des.NewCipher(#<SyntaxTree::Ident:0x000075853ece2ff0>)
	plaintext := #<SyntaxTree::Const:0x000075853ece1f10>[byte].new("blockdat")
	ct := make(#<SyntaxTree::Const:0x000075853ece1290>[byte], des.BlockSize)
	#<SyntaxTree::Ident:0x000075853ece0980>.Encrypt(#<SyntaxTree::Ident:0x000075853ece0728>, #<SyntaxTree::Ident:0x000075853ece04f8>)
	pt := make(#<SyntaxTree::Const:0x0000758540e3ff68>[byte], des.BlockSize)
	#<SyntaxTree::Ident:0x0000758540e3f658>.Decrypt(#<SyntaxTree::Ident:0x0000758540e3f400>, #<SyntaxTree::Ident:0x0000758540e3f108>)
	fmt.Printf("block size: %d\nct: %x\npt: %s\n", #<SyntaxTree::Ident:0x0000758540e3e7f8>.BlockSize(), #<SyntaxTree::Ident:0x0000758540e3e410>, #<SyntaxTree::Ident:0x0000758540e3e280>)
}

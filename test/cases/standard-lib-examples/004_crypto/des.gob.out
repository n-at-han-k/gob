package main

import (
	"crypto/des"
	"fmt"
	"log"
)

func runDES() {
	key := []byte("8bytekey")
	if block, err := des.NewCipher(key); err != nil {
		log.Fatal(err)
	}
	plaintext := []byte("blockdat")
	ct := make(#<SyntaxTree::ArrayLiteral:0x00007fff79ed83e0>, des.BlockSize)
	block.Encrypt(ct, plaintext)
	pt := make(#<SyntaxTree::ArrayLiteral:0x00007fff79f6f470>, des.BlockSize)
	block.Decrypt(pt, ct)
	fmt.Printf("block size: %d\nct: %x\npt: %s\n", block.BlockSize(), ct, pt)
}

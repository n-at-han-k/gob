package main

import (
	"crypto/des"
	"fmt"
	"log"
)

func runDES() () {
	key := #<SyntaxTree::Const:0x00007e5e8c8e7100>[byte].new("8bytekey")
	block, err := des.NewCipher(#<SyntaxTree::Ident:0x00007e5e8c8e60c0>)
	plaintext := #<SyntaxTree::Const:0x00007e5e8c8e4f40>[byte].new("blockdat")
	ct := make(#<SyntaxTree::Const:0x00007e5e8c8e42c0>[byte], des.BlockSize)
	#<SyntaxTree::Ident:0x00007e5e8c8e39b0>.Encrypt(#<SyntaxTree::Ident:0x00007e5e8c8e3758>, #<SyntaxTree::Ident:0x00007e5e8c8e3528>)
	pt := make(#<SyntaxTree::Const:0x00007e5e8c8e2df8>[byte], des.BlockSize)
	#<SyntaxTree::Ident:0x00007e5e8c8e24c0>.Decrypt(#<SyntaxTree::Ident:0x00007e5e8c8e2268>, #<SyntaxTree::Ident:0x00007e5e8c8e2038>)
	fmt.Printf("block size: %d\nct: %x\npt: %s\n", #<SyntaxTree::Ident:0x00007e5e8c8e1750>.BlockSize(), #<SyntaxTree::Ident:0x00007e5e8c8e1368>, #<SyntaxTree::Ident:0x00007e5e8c8e11d8>)
}

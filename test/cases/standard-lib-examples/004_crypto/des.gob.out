package main

import (
	"crypto/des"
	"fmt"
	"log"
)

func runDES() {
	key := nil.new("8bytekey")
	block, err := des.NewCipher(key)
	plaintext := nil.new("blockdat")
	ct := make(nil, des.BlockSize)
	block.Encrypt(ct, plaintext)
	pt := make(nil, des.BlockSize)
	block.Decrypt(pt, ct)
	fmt.Printf("block size: %d\nct: %x\npt: %s\n", block.BlockSize(), ct, pt)
}

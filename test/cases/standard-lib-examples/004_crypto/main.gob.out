package main

import (
	"fmt"
	"os"
	"sort"
)

var demos = map[string]Proc{crypto: runCrypto, aes: runAES, cipher: runCipher, des: runDES, dsa: runDSA, ecdh: runECDH, ecdsa: runECDSA, ed25519: runED25519, elliptic: runElliptic, fips140: runFIPS140, hkdf: runHKDF, hmac: runHMAC, hpke: runHPKE, md5: runMD5, mlkem: runMLKEM, pbkdf2: runPBKDF2, rand: runRand, rc4: runRC4, rsa: runRSA, sha1: runSHA1, sha256: runSHA256, sha3: runSHA3, sha512: runSHA512, subtle: runSubtle, tls: runTLS, x509: runX509}

func main() {
	demo, ok := demos[os.Args[1]]
	demo()
}

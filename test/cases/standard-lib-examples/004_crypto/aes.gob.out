package main

import (
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"fmt"
	"log"
)

func runAES() () {
	key := make(#<SyntaxTree::Const:0x00007e5ee042e060>[byte], 32)
	rand.Read(#<SyntaxTree::Ident:0x00007e5ee042bc70>)
	block, err := aes.NewCipher(#<SyntaxTree::Ident:0x00007e5ee042a9b0>)
	gcm, _ := cipher.NewGCM(#<SyntaxTree::Ident:0x00007e5ee0427df0>)
	nonce := make(#<SyntaxTree::Const:0x00007e5ee0426ae0>[byte], #<SyntaxTree::Ident:0x00007e5ee04263b0>.NonceSize())
	rand.Read(#<SyntaxTree::Ident:0x00007e5ee04259d8>)
	plaintext := #<SyntaxTree::Const:0x00007e5ee04252a8>[byte].new("secret message")
	ct := #<SyntaxTree::Ident:0x00007e5ee04241a0>.Seal(#<SyntaxTree::Kw:0x00007e5ee39b9298>, #<SyntaxTree::Ident:0x00007e5ee0423958>, #<SyntaxTree::Ident:0x00007e5ee0423778>, #<SyntaxTree::Kw:0x00007e5ee39b8f78>)
	pt, err := #<SyntaxTree::Ident:0x00007e5ee0422670>.Open(#<SyntaxTree::Kw:0x00007e5ee39b8708>, #<SyntaxTree::Ident:0x00007e5ee0421798>, #<SyntaxTree::Ident:0x00007e5ee04211d0>, #<SyntaxTree::Kw:0x00007e5ee39b83e8>)
	fmt.Printf("ciphertext (%d bytes): %x\n", len(#<SyntaxTree::Ident:0x00007e5ee043ed20>), #<SyntaxTree::Ident:0x00007e5ee043e708>)
	fmt.Printf("decrypted: %s\n", #<SyntaxTree::Ident:0x00007e5ee043d718>)
}

package main

import (
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"fmt"
	"log"
)

func runAES() {
	key := make(#<SyntaxTree::ArrayLiteral:0x00007fff79410020>, 32)
	rand.Read(key)
	if block, err := aes.NewCipher(key); err != nil {
		log.Fatal(err)
	}
	gcm, _ := cipher.NewGCM(block)
	nonce := make(#<SyntaxTree::ArrayLiteral:0x00007fff79478fd0>, gcm.NonceSize())
	rand.Read(nonce)
	plaintext := []byte("secret message")
	ct := gcm.Seal(nil, nonce, plaintext, nil)
	if pt, err := gcm.Open(nil, nonce, ct, nil); err != nil {
		log.Fatal(err)
	}
	fmt.Printf("ciphertext (%d bytes): %x\n", len(ct), ct)
	fmt.Printf("decrypted: %s\n", pt)
}

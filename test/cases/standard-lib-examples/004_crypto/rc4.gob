require "crypto/rc4"
require "fmt"
require "log"

module Main
  def runRC4
    c, err = rc4.NewCipher(Array[byte].("weakkey"))
    if err
      log.Fatal(err)
    end

    pt = Array[byte].("legacy data")
    ct = make(Array[byte], len(pt))
    c.XORKeyStream(ct, pt)

    c2, _ = rc4.NewCipher(Array[byte].("weakkey"))
    out = make(Array[byte], len(ct))
    c2.XORKeyStream(out, ct)

    fmt.Printf("ct: %x\npt: %s\n", ct, out)
  end
end

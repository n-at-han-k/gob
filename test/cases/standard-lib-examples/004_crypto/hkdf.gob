require "crypto/hkdf"
require "crypto/sha256"
require "fmt"
require "log"

module Main
  def runHKDF
    secret = Array[byte].new("some shared secret bytes")
    salt = Array[byte].new("optional salt")
    info = Array[byte].new("app: session key v1")

    key, err = hkdf.Key(sha256.New, secret, salt, string(info), 32)
    if err
      log.Fatal(err)
    end
    fmt.Printf("derived 32-byte key: %x\n", key)
  end
end

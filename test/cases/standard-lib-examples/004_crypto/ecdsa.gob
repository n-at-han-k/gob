require "crypto/ecdsa"
require "crypto/elliptic"
require "crypto/rand"
require "crypto/sha256"
require "fmt"
require "log"

module Main
  def runECDSA
    priv, err = ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
    if err
      log.Fatal(err)
    end

    digest = sha256.Sum256(Array[byte].("attack at dawn"))
    sig, _ = ecdsa.SignASN1(rand.Reader, priv, digest[])
    ok = ecdsa.VerifyASN1(@priv.PublicKey, digest[], sig)

    fmt.Printf("signature (%d B): %x\n", len(sig), sig)
    fmt.Println("valid:", ok)
  end
end

require "crypto/aes"
require "crypto/cipher"
require "crypto/rand"
require "fmt"
require "log"

module Main
  def runAES
    key = make(Array[byte], 32)
    rand.Read(key)

    block, err = aes.NewCipher(key)
    if err != nil
      log.Fatal(err)
    end
    gcm, _ = cipher.NewGCM(block)

    nonce = make(Array[byte], gcm.NonceSize())
    rand.Read(nonce)

    plaintext = Array[byte].new("secret message")
    ct = gcm.Seal(nil, nonce, plaintext, nil)
    pt, err = gcm.Open(nil, nonce, ct, nil)
    if err != nil
      log.Fatal(err)
    end

    fmt.Printf("ciphertext (%d bytes): %x\n", len(ct), ct)
    fmt.Printf("decrypted: %s\n", pt)
  end
end

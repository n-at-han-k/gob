require "crypto/hmac"
require "crypto/sha256"
require "fmt"

module Main
  def runHMAC
    key = Array[byte].("shared secret")
    msg = Array[byte].("transfer $100")

    mac = hmac.New(sha256.New, key)
    mac.Write(msg)
    tag = mac.Sum(nil)

    check = hmac.New(sha256.New, key)
    check.Write(msg)
    fmt.Printf("tag: %x\n", tag)
    fmt.Println("valid:", hmac.Equal(tag, check.Sum(nil)))
  end
end

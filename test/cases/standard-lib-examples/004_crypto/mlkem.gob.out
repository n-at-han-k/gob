package main

import (
	"bytes"
	"crypto/mlkem"
	"fmt"
	"log"
)

func runMLKEM() () {
	dk, err := mlkem.GenerateKey768()
	ek := #<SyntaxTree::Ident:0x00007d6a5002bf88>.EncapsulationKey()
	shared1, ct := #<SyntaxTree::Ident:0x00007d6a5002b7e0>.Encapsulate()
	shared2, err := #<SyntaxTree::Ident:0x00007d6a5002afe8>.Decapsulate(#<SyntaxTree::Ident:0x00007d6a5002ad90>)
	fmt.Printf("shared secret (%d B): %x\n", len(#<SyntaxTree::Ident:0x00007d6a500297b0>), #<SyntaxTree::Ident:0x00007d6a50029418>)
	fmt.Println("both sides agree:", bytes.Equal(#<SyntaxTree::Ident:0x00007d6a500289a0>, #<SyntaxTree::Ident:0x00007d6a50028770>))
}

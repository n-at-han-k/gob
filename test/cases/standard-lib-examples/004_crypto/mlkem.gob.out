package main

import (
	"bytes"
	"crypto/mlkem"
	"fmt"
	"log"
)

func runMLKEM() () {
	dk, err := mlkem.GenerateKey768()
	ek := #<SyntaxTree::Ident:0x00007e5e94e4b738>.EncapsulationKey()
	shared1, ct := #<SyntaxTree::Ident:0x00007e5e94e4abf8>.Encapsulate()
	shared2, err := #<SyntaxTree::Ident:0x00007e5e94e49e60>.Decapsulate(#<SyntaxTree::Ident:0x00007e5e94e492f8>)
	fmt.Printf("shared secret (%d B): %x\n", len(#<SyntaxTree::Ident:0x00007e5e94e45b08>), #<SyntaxTree::Ident:0x00007e5e94e44c30>)
	fmt.Println("both sides agree:", bytes.Equal(#<SyntaxTree::Ident:0x00007e5e94e43628>, #<SyntaxTree::Ident:0x00007e5e94e43088>))
}

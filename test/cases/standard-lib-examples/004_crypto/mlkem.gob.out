package main

import (
	"bytes"
	"crypto/mlkem"
	"fmt"
	"log"
)

func runMLKEM() () {
	dk, err := mlkem.GenerateKey768()
	ek := #<SyntaxTree::Ident:0x0000758540e399b0>.EncapsulationKey()
	shared1, ct := #<SyntaxTree::Ident:0x0000758540e39208>.Encapsulate()
	shared2, err := #<SyntaxTree::Ident:0x0000758540e38a10>.Decapsulate(#<SyntaxTree::Ident:0x0000758540e387b8>)
	fmt.Printf("shared secret (%d B): %x\n", len(#<SyntaxTree::Ident:0x0000758540e371d8>), #<SyntaxTree::Ident:0x0000758540e36e40>)
	fmt.Println("both sides agree:", bytes.Equal(#<SyntaxTree::Ident:0x0000758540e363a0>, #<SyntaxTree::Ident:0x0000758540e36170>))
}

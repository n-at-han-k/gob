package main

import (
	"bytes"
	"crypto/mlkem"
	"fmt"
	"log"
)

func runMLKEM() {
	if dk, err := mlkem.GenerateKey768(); err != nil {
		log.Fatal(err)
	}
	ek := dk.EncapsulationKey()
	shared1, ct := ek.Encapsulate()
	if shared2, err := dk.Decapsulate(ct); err != nil {
		log.Fatal(err)
	}
	fmt.Printf("shared secret (%d B): %x\n", len(shared1), shared1)
	fmt.Println("both sides agree:", bytes.Equal(shared1, shared2))
}

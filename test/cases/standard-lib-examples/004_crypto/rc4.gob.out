package main

import (
	"crypto/rc4"
	"fmt"
	"log"
)

func runRC4() () {
	c, err := rc4.NewCipher(#<SyntaxTree::Const:0x00007e5e8c922de0>[byte].new("weakkey"))
	pt := #<SyntaxTree::Const:0x00007e5e8c921198>[byte].new("legacy data")
	ct := make(#<SyntaxTree::Const:0x00007e5e8c9204f0>[byte], len(#<SyntaxTree::Ident:0x00007e5e8c8bfee8>))
	#<SyntaxTree::Ident:0x00007e5e8c8bf8a8>.XORKeyStream(#<SyntaxTree::Ident:0x00007e5e8c8bf600>, #<SyntaxTree::Ident:0x00007e5e8c8bf3a8>)
	c2, _ := rc4.NewCipher(#<SyntaxTree::Const:0x00007e5e8c8be9f8>[byte].new("weakkey"))
	out := make(#<SyntaxTree::Const:0x00007e5e8c8bd8f0>[byte], len(#<SyntaxTree::Ident:0x00007e5e8c8bd198>))
	#<SyntaxTree::Ident:0x00007e5e8c8bcc48>.XORKeyStream(#<SyntaxTree::Ident:0x00007e5e8c8bc9f0>, #<SyntaxTree::Ident:0x00007e5e8c8bc770>)
	fmt.Printf("ct: %x\npt: %s\n", #<SyntaxTree::Ident:0x00007e5e8c8bbdc0>, #<SyntaxTree::Ident:0x00007e5e8c8bbb90>)
}

package main

import (
	"crypto/hmac"
	"crypto/sha256"
	"fmt"
)

func runHMAC() {
	key := []byte("shared secret")
	msg := []byte("transfer $100")
	mac := hmac.New(sha256.New, key)
	mac.Write(msg)
	tag := mac.Sum(nil)
	check := hmac.New(sha256.New, key)
	check.Write(msg)
	fmt.Printf("tag: %x\n", tag)
	fmt.Println("valid:", hmac.Equal(tag, check.Sum(nil)))
}

package main

import (
	"crypto/sha3"
	"fmt"
)

func runSHA3() {
	fmt.Printf("Sum256: %x\n", sha3.Sum256(nil.new("hello")))
	fmt.Printf("Sum512: %x\n", sha3.Sum512(nil.new("hello")))
	shake := sha3.NewSHAKE128()
	shake.Write(nil.new("hello"))
	out := make(nil, 42)
	shake.Read(out)
	fmt.Printf("shake128 (42 B): %x\n", out)
}

require "crypto/dsa"
require "crypto/rand"
require "crypto/sha256"
require "fmt"
require "log"

module Main
  def runDSA
    var :params, dsa.Parameters
    if err = dsa.GenerateParameters(@params, rand.Reader, dsa.L1024N160)
      log.Fatal(err)
    end

    priv = @dsa.PrivateKey.new(PublicKey: dsa.PublicKey.new(Parameters: params))
    if err = dsa.GenerateKey(priv, rand.Reader)
      log.Fatal(err)
    end

    digest = sha256.Sum256(Array[byte].new("hello"))
    r, s, err = dsa.Sign(rand.Reader, priv, digest[])
    if err
      log.Fatal(err)
    end
    ok = dsa.Verify(@priv.PublicKey, digest[], r, s)
    fmt.Println("signature valid:", ok)
  end
end

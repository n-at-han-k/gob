require "crypto/des"
require "fmt"
require "log"

module Main
  def runDES
    key = Array[byte].new("8bytekey")
    block, err = des.NewCipher(key)
    if err != nil
      log.Fatal(err)
    end

    plaintext = Array[byte].new("blockdat")
    ct = make(Array[byte], des.BlockSize)
    block.Encrypt(ct, plaintext)

    pt = make(Array[byte], des.BlockSize)
    block.Decrypt(pt, ct)

    fmt.Printf("block size: %d\nct: %x\npt: %s\n", block.BlockSize(), ct, pt)
  end
end

package main

import (
	"crypto/subtle"
	"fmt"
)

func runSubtle() {
	a := []byte("expected-token")
	b := []byte("expected-token")
	c := []byte("wrong-token   ")
	fmt.Println("equal (constant time):", subtle.ConstantTimeCompare(a, b) == 1)
	fmt.Println("not equal:            ", subtle.ConstantTimeCompare(a, c) == 1)
}

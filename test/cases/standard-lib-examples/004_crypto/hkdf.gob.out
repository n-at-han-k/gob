package main

import (
	"crypto/hkdf"
	"crypto/sha256"
	"fmt"
	"log"
)

func runHKDF() () {
	secret := #<SyntaxTree::Const:0x00007e5e8c9132f0>[byte].new("some shared secret bytes")
	salt := #<SyntaxTree::Const:0x00007e5e8c912710>[byte].new("optional salt")
	info := #<SyntaxTree::Const:0x00007e5e8c911b80>[byte].new("app: session key v1")
	key, err := hkdf.Key(sha256.New, #<SyntaxTree::Ident:0x00007e5e8c9107a8>, #<SyntaxTree::Ident:0x00007e5e8c910618>, string(#<SyntaxTree::Ident:0x00007e5e8c910398>), 32)
	fmt.Printf("derived 32-byte key: %x\n", #<SyntaxTree::Ident:0x00007e5e8c92ebb8>)
}

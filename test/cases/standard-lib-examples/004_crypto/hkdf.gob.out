package main

import (
	"crypto/hkdf"
	"crypto/sha256"
	"fmt"
	"log"
)

func runHKDF() () {
	secret := #<SyntaxTree::Const:0x00007585969b8bd8>[byte].new("some shared secret bytes")
	salt := #<SyntaxTree::Const:0x00007585969b8020>[byte].new("optional salt")
	info := #<SyntaxTree::Const:0x00007585969b7490>[byte].new("app: session key v1")
	key, err := hkdf.Key(sha256.New, #<SyntaxTree::Ident:0x00007585969b61a8>, #<SyntaxTree::Ident:0x00007585969b6018>, string(#<SyntaxTree::Ident:0x00007585969b5d98>), 32)
	fmt.Printf("derived 32-byte key: %x\n", #<SyntaxTree::Ident:0x00007585969b4628>)
}

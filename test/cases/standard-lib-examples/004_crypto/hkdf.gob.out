package main

import (
	"crypto/hkdf"
	"crypto/sha256"
	"fmt"
	"log"
)

func runHKDF() () {
	secret := #<SyntaxTree::Const:0x00007d6a483df830>[byte].new("some shared secret bytes")
	salt := #<SyntaxTree::Const:0x00007d6a483dec78>[byte].new("optional salt")
	info := #<SyntaxTree::Const:0x00007d6a483de070>[byte].new("app: session key v1")
	key, err := hkdf.Key(sha256.New, #<SyntaxTree::Ident:0x00007d6a483dcd60>, #<SyntaxTree::Ident:0x00007d6a483dcbd0>, string(#<SyntaxTree::Ident:0x00007d6a483dc950>), 32)
	fmt.Printf("derived 32-byte key: %x\n", #<SyntaxTree::Ident:0x00007d6a483db0c8>)
}

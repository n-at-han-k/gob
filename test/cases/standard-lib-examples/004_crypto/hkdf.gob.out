package main

import (
	"crypto/hkdf"
	"crypto/sha256"
	"fmt"
	"log"
)

func runHKDF() {
	secret := nil.new("some shared secret bytes")
	salt := nil.new("optional salt")
	info := nil.new("app: session key v1")
	key, err := hkdf.Key(sha256.New, secret, salt, string(info), 32)
	if err != nil {
		log.Fatal(err)
	}
	fmt.Printf("derived 32-byte key: %x\n", key)
}

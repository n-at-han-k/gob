package main

import (
	"bytes"
	"crypto/ecdh"
	"crypto/rand"
	"fmt"
	"log"
)

func runECDH() () {
	curve := ecdh.P256()
	alice, err := #<SyntaxTree::Ident:0x00007e5ee39a8088>.GenerateKey(rand.Reader)
	bob, _ := #<SyntaxTree::Ident:0x00007e5ee39a6a58>.GenerateKey(rand.Reader)
	shareA, _ := #<SyntaxTree::Ident:0x00007e5ee39a5f18>.ECDH(#<SyntaxTree::Ident:0x00007e5ee39a5cc0>.PublicKey())
	shareB, _ := #<SyntaxTree::Ident:0x00007e5ee39a52e8>.ECDH(#<SyntaxTree::Ident:0x00007e5ee39a5090>.PublicKey())
	fmt.Printf("shared secret (%d B): %x\n", len(#<SyntaxTree::Ident:0x00007e5ee39a4348>), #<SyntaxTree::Ident:0x00007e5ee39a3f60>)
	fmt.Println("both sides agree:", bytes.Equal(#<SyntaxTree::Ident:0x00007e5ee39a34c0>, #<SyntaxTree::Ident:0x00007e5ee39a3290>))
}

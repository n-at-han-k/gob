package main

import (
	"crypto/sha256"
	"fmt"
)

func runSHA256() {
	fmt.Printf("Sum256:   %x\n", sha256.Sum256(nil.new("hello")))
	fmt.Printf("Sum224:   %x\n", sha256.Sum224(nil.new("hello")))
	h := sha256.New()
	h.Write(nil.new("hel"))
	h.Write(nil.new("lo"))
	fmt.Printf("streamed: %x\n", h.Sum(nil))
}

require "os"
require "os/exec"
require "syscall"

module Main
  def main
    binary, lookErr = exec.LookPath("ls")
    if lookErr != nil
      panic(lookErr)
    end

    args = Array[string].new("ls", "-a", "-l", "-h")

    env = os.Environ()

    execErr = syscall.Exec(binary, args, env)
    if execErr != nil
      panic(execErr)
    end
  end
end

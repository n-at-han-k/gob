require "fmt"
require "sync"
require "time"

module Main
  def worker(id) # (int)
    fmt.Printf("Worker %d starting\n", id)

    time.Sleep(time.Second)
    fmt.Printf("Worker %d done\n", id)
  end

  def main
    var :wg, sync.WaitGroup

    i = 1
    while i <= 5
      wg.Go(lambda {
        worker(i)
      })
      i = i + 1
    end

    wg.Wait()
  end
end

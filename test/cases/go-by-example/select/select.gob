require "fmt"
require "time"

module Main
  def main
    c1 = make(Chan[string])
    c2 = make(Chan[string])

    go lambda {
      time.Sleep(1 * time.Second)
      c1 << "one"
    }.()

    go lambda {
      time.Sleep(2 * time.Second)
      c2 << "two"
    }.()

    2.times do
      case
      when msg1 = c1.<<
        fmt.Println("received", msg1)
      when msg2 = c2.<<
        fmt.Println("received", msg2)
      end
    end
  end
end

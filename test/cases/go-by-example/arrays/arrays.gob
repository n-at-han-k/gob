require "fmt"

module Main
  def main
    var :a, Array[int, 5]
    fmt.Println("emp:", a)

    a[4] = 100
    fmt.Println("set:", a)
    fmt.Println("get:", a[4])

    fmt.Println("len:", len(a))

    b = Array[int, 5].new(1, 2, 3, 4, 5)
    fmt.Println("dcl:", b)

    b = Array[int, 5].new(1, 2, 3, 4, 5)
    fmt.Println("dcl:", b)

    b = Array[int, 5].new(100, 0, 0, 400, 500)
    fmt.Println("idx:", b)

    var :twoD, Array[Array[int, 3], 2]
    2.times do |i|
      3.times do |j|
        twoD[i][j] = i + j
      end
    end
    fmt.Println("2d: ", twoD)

    twoD = Array[Array[int, 3], 2].new(Array[int, 3].new(1, 2, 3), Array[int, 3].new(1, 2, 3))
    fmt.Println("2d: ", twoD)
  end
end

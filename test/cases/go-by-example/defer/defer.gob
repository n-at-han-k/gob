require "fmt"
require "os"
require "path/filepath"

module Main
  def main
    path = filepath.Join(os.TempDir(), "defer.txt")
    f = createFile(path)
    defer closeFile(f)
    writeFile(f)
  end

  def createFile(p) # (string) -> *os.File
    fmt.Println("creating")
    f, err = os.Create(p)
    if err != nil
      panic(err)
    end
    return f
  end

  def writeFile(f) # (*os.File)
    fmt.Println("writing")
    fmt.Fprintln(f, "data")
  end

  def closeFile(f) # (*os.File)
    fmt.Println("closing")
    err = f.Close()
    if err != nil
      panic(err)
    end
  end
end

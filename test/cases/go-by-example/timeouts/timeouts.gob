require "fmt"
require "time"

module Main
  def main
    c1 = make(Chan[string], 1)
    go lambda {
      time.Sleep(2 * time.Second)
      c1 << "result 1"
    }.()

    case
    when res = ~c1
      fmt.Println(res)
    when ~time.After(1 * time.Second)
      fmt.Println("timeout 1")
    end

    c2 = make(Chan[string], 1)
    go lambda {
      time.Sleep(2 * time.Second)
      c2 << "result 2"
    }.()

    case
    when res = ~c2
      fmt.Println(res)
    when ~time.After(3 * time.Second)
      fmt.Println("timeout 2")
    end
  end
end

require "fmt"
require "slices"

module Main
  def main
    var :s, Array[string]
    fmt.Println("uninit:", s, s == nil, len(s) == 0)

    s = make(Array[string], 3)
    fmt.Println("emp:", s, "len:", len(s), "cap:", cap(s))

    s[0] = "a"
    s[1] = "b"
    s[2] = "c"
    fmt.Println("set:", s)
    fmt.Println("get:", s[2])

    fmt.Println("len:", len(s))

    s = append(s, "d")
    s = append(s, "e", "f")
    fmt.Println("apd:", s)

    c = make(Array[string], len(s))
    copy(c, s)
    fmt.Println("cpy:", c)

    l = s[2...5]
    fmt.Println("sl1:", l)

    l = s[...5]
    fmt.Println("sl2:", l)

    l = s[2...]
    fmt.Println("sl3:", l)

    t = Array[string].new("g", "h", "i")
    fmt.Println("dcl:", t)

    t2 = Array[string].new("g", "h", "i")
    if slices.Equal(t, t2)
      fmt.Println("t == t2")
    end

    twoD = make(Array[Array[int]], 3)
    3.times do |i|
      innerLen = i + 1
      twoD[i] = make(Array[int], innerLen)
      innerLen.times do |j|
        twoD[i][j] = i + j
      end
    end
    fmt.Println("2d: ", twoD)
  end
end

require "fmt"
require "time"

module Main
  def main
    ticker = time.NewTicker(500 * time.Millisecond)
    done = make(Chan[bool])

    go lambda {
      loop do
        case
        when done.<<
          return
        when t = ticker.C.<<
          fmt.Println("Tick at", t)
        end
      end
    }.()

    time.Sleep(1600 * time.Millisecond)
    ticker.Stop()
    done << true
    fmt.Println("Ticker stopped")
  end
end
